# App Store Connect API Key Configuration
# Copy this file to .env and fill in your actual values
# 
# To get these values:
# 1. Go to App Store Connect → Users and Access → Keys tab
# 2. Create a new API key with "App Manager" role
# 3. Download the .p8 file and note the Key ID and Issuer ID

# Your App Store Connect API Key ID (e.g., "D383SF739")
APP_STORE_CONNECT_API_KEY_ID=B8G72J8L8W

# Your App Store Connect Issuer ID (UUID format, found at top of Keys page)
APP_STORE_CONNECT_ISSUER_ID=55d905f9-211e-4a10-b7ee-4d0d0392448c

# Path to your downloaded .p8 API key file (relative to project root)
APP_STORE_CONNECT_API_KEY_PATH=./fastlane/AuthKey_B8G72J8L8W.p8

# Optional: Team ID if you're on multiple teams
# FASTLANE_TEAM_ID=your_team_id_here

# Optional: App identifier (bundle ID)
# FASTLANE_APP_IDENTIFIER=timothy.veil.LeavesOfBlocks
