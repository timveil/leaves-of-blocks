# Uncomment the line if you want fastlane to automatically update itself
# update_fastlane

default_platform(:ios)

platform :ios do
  before_all do
    ensure_xcode_version(version: "16.4")
  end
  
  # Helper function to extract latest changelog entry for TestFlight
  def get_latest_changelog
    changelog_path = "../CHANGELOG.md"
    unless File.exist?(changelog_path)
      return "Latest improvements and bug fixes for testing."
    end
    
    content = File.read(changelog_path)
    
    # Extract content between [Unreleased] and the next version
    unreleased_match = content.match(/## \[Unreleased\](.*?)(?=## \[[\d\.]+\])/m)
    
    if unreleased_match && !unreleased_match[1].strip.empty?
      # Use unreleased changes if they exist
      changelog_content = unreleased_match[1].strip
    else
      # Fall back to latest released version
      latest_version_match = content.match(/## \[[\d\.]+\] - [\d-]+\n(.*?)(?=## \[|$)/m)
      changelog_content = latest_version_match ? latest_version_match[1].strip : "Latest improvements and bug fixes."
    end
    
    # Clean up the content and format for TestFlight
    lines = changelog_content.split("\n").reject(&:empty?)
    formatted_lines = []
    current_section = ""
    
    lines.each do |line|
      if line.start_with?("### ")
        current_section = line.gsub("### ", "").strip
        unless current_section.empty? || %w[Changed Deprecated Removed Security].include?(current_section)
          formatted_lines << "\n#{current_section}:" unless formatted_lines.empty?
        end
      elsif line.start_with?("- ")
        formatted_lines << line if %w[Added Fixed].include?(current_section)
      end
    end
    
    result = formatted_lines.join("\n").strip
    result.empty? ? "Latest improvements and bug fixes for testing." : result
  end

  desc "Run tests"
  lane :test do
    run_tests(
      project: "LeavesOfBlocks.xcodeproj",
      scheme: "LeavesOfBlocks",
      destination: "platform=iOS Simulator,name=iPhone 16"
    )
  end

  desc "Build for testing"
  lane :build_for_testing do
    build_app(
      project: "LeavesOfBlocks.xcodeproj",
      scheme: "LeavesOfBlocks",
      destination: "platform=iOS Simulator,name=iPhone 16",
      skip_archive: true,
      skip_codesigning: true
    )
  end

  desc "Create a new build for App Store"
  lane :build do
    increment_build_number(xcodeproj: "LeavesOfBlocks.xcodeproj")
    build_app(
      project: "LeavesOfBlocks.xcodeproj",
      scheme: "LeavesOfBlocks",
      export_method: "app-store"
    )
  end

  desc "Upload to TestFlight"
  lane :beta do
    # Configure App Store Connect API key
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_API_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_filepath: ENV["APP_STORE_CONNECT_API_KEY_PATH"] || "./AuthKey.p8",
      duration: 1200,
      in_house: false
    )
    
    # Increment marketing version to create new release train
    increment_version_number(
      xcodeproj: "LeavesOfBlocks.xcodeproj",
      version_number: "1.0.3"  # Explicitly set new version to resolve closed train
    )
    increment_build_number(xcodeproj: "LeavesOfBlocks.xcodeproj")
    build_app(
      project: "LeavesOfBlocks.xcodeproj",
      scheme: "LeavesOfBlocks",
      export_method: "app-store"
    )
    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      changelog: get_latest_changelog
    )
  end

  desc "Upload to App Store"
  lane :release do
    # Configure App Store Connect API key
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_API_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_filepath: ENV["APP_STORE_CONNECT_API_KEY_PATH"] || "./AuthKey.p8",
      duration: 1200,
      in_house: false
    )
    
    increment_build_number(xcodeproj: "LeavesOfBlocks.xcodeproj")
    build_app(
      project: "LeavesOfBlocks.xcodeproj",
      scheme: "LeavesOfBlocks",
      export_method: "app-store"
    )
    upload_to_app_store(
      api_key: api_key,
      force: true,
      submit_for_review: false
    )
  end

  desc "Upload metadata and screenshots only (no binary)"
  lane :metadata_only do
    # Configure App Store Connect API key
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_API_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_filepath: ENV["APP_STORE_CONNECT_API_KEY_PATH"] || "./AuthKey.p8",
      duration: 1200,
      in_house: false
    )
    
    deliver(
      api_key: api_key,
      skip_binary_upload: true,
      skip_screenshots: false,
      skip_metadata: false,
      force: true
    )
  end

  desc "Upload screenshots only"
  lane :screenshots_only do
    # Configure App Store Connect API key
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_API_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_filepath: ENV["APP_STORE_CONNECT_API_KEY_PATH"] || "./AuthKey.p8",
      duration: 1200,
      in_house: false
    )
    
    deliver(
      api_key: api_key,
      skip_binary_upload: true,
      skip_screenshots: false,
      skip_metadata: true,
      force: true
    )
  end

  desc "Complete App Store deployment with metadata and binary"
  lane :deploy do
    # Increment build number
    increment_build_number(xcodeproj: "LeavesOfBlocks.xcodeproj")
    
    # Build the app
    build_app(
      project: "LeavesOfBlocks.xcodeproj",
      scheme: "LeavesOfBlocks",
      export_method: "app-store"
    )
    
    # Upload everything using deliver with JSON API key file
    deliver(
      api_key_path: "fastlane/AuthKey_B8G72J8L8W.json",
      submit_for_review: false,
      automatic_release: false,
      force: true
    )
    
    UI.success("🚀 App deployed to App Store Connect!")
    UI.message("📱 Binary, metadata, and screenshots uploaded")
    UI.message("⏳ Check App Store Connect for build processing status")
  end

  desc "Submit for App Store review (use after deploy)"
  lane :submit do
    # Configure App Store Connect API key
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_API_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_filepath: ENV["APP_STORE_CONNECT_API_KEY_PATH"] || "./AuthKey.p8",
      duration: 1200,
      in_house: false
    )
    
    deliver(
      api_key: api_key,
      submit_for_review: true,
      automatic_release: false,
      force: true,
      skip_binary_upload: true,
      skip_metadata: true,
      skip_screenshots: true
    )
    
    UI.success("📝 App submitted for App Store review!")
  end

  desc "Full deployment pipeline: build, upload, and submit for review"
  lane :deploy_and_submit do
    # Configure App Store Connect API key
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_API_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_filepath: ENV["APP_STORE_CONNECT_API_KEY_PATH"] || "./AuthKey.p8",
      duration: 1200,
      in_house: false
    )
    
    # Increment build number
    increment_build_number(xcodeproj: "LeavesOfBlocks.xcodeproj")
    
    # Build the app
    build_app(
      project: "LeavesOfBlocks.xcodeproj",
      scheme: "LeavesOfBlocks",
      export_method: "app-store"
    )
    
    # Upload everything and submit for review
    deliver(
      api_key: api_key,
      submit_for_review: true,
      automatic_release: false,
      force: true,
      skip_waiting_for_build_processing: false
    )
    
    UI.success("🎉 Complete deployment finished!")
    UI.message("📱 Binary uploaded and submitted for review")
    UI.message("⏳ Apple will review your app within 24-48 hours")
  end

  desc "Generate new localized screenshots"
  lane :screenshots do
    # Build for testing first
    build_for_testing
    
    # Capture screenshots using snapshot (configuration from Snapfile)
    capture_screenshots(
      number_of_retries: 0
    )
    
    UI.success("✅ Screenshots captured successfully!")
    UI.message("📱 Find your screenshots in: fastlane/screenshots/")
    UI.message("📄 HTML report: fastlane/screenshots/screenshots.html")
  end

  desc "Generate manual screenshots (simulator only)"
  lane :manual_screenshots do
    UI.message("🚀 Building app for manual screenshot capture...")
    
    # Build the app for simulator
    build_for_testing
    
    UI.success("✅ App built successfully!")
    UI.message("📱 To capture screenshots manually:")
    UI.message("1. Open iOS Simulator")
    UI.message("2. Launch your app from Xcode or run: xcrun simctl launch booted timothy.veil.LeavesOfBlocks")
    UI.message("3. Navigate through your app")
    UI.message("4. Press ⌘+S in Simulator to save screenshots")
    UI.message("5. Screenshots will be saved to ~/Desktop")
    UI.message("")
    UI.message("💡 Pro tip: Use ⌘+1, ⌘+2, ⌘+3 to switch device sizes quickly")
  end

  desc "App Clip build"
  lane :build_app_clip do
    build_app(
      project: "LeavesOfBlocks.xcodeproj",
      scheme: "LeavesOfBlocksAppClip",
      export_method: "app-store"
    )
  end

  desc "Update changelog for new release"
  lane :update_changelog do |options|
    version = options[:version] || prompt(text: "Enter version (e.g., 1.0.4):")
    date = options[:date] || Time.now.strftime("%Y-%m-%d")
    
    changelog_path = "../CHANGELOG.md"
    unless File.exist?(changelog_path)
      UI.error("CHANGELOG.md not found!")
      next
    end
    
    content = File.read(changelog_path)
    
    # Replace [Unreleased] with the new version
    updated_content = content.gsub(
      "## [Unreleased]",
      "## [Unreleased]\n\n### Added\n\n### Changed\n\n### Deprecated\n\n### Removed\n\n### Fixed\n\n### Security\n\n## [#{version}] - #{date}"
    )
    
    # Update the links at the bottom
    if updated_content.include?("[Unreleased]: https://github.com/timveil/leaves-of-blocks/compare/")
      # Find the current latest version for the unreleased link
      latest_version_match = updated_content.match(/\[Unreleased\]: https:\/\/github\.com\/timveil\/leaves-of-blocks\/compare\/v([\d\.]+)\.\.\.HEAD/)
      if latest_version_match
        old_version = latest_version_match[1]
        updated_content = updated_content.gsub(
          "[Unreleased]: https://github.com/timveil/leaves-of-blocks/compare/v#{old_version}...HEAD",
          "[Unreleased]: https://github.com/timveil/leaves-of-blocks/compare/v#{version}...HEAD\n[#{version}]: https://github.com/timveil/leaves-of-blocks/compare/v#{old_version}...v#{version}"
        )
      end
    end
    
    File.write(changelog_path, updated_content)
    UI.success("✅ Changelog updated for version #{version}")
    UI.message("📝 Don't forget to:")
    UI.message("1. Fill in the [Unreleased] section before your next release")
    UI.message("2. Move items from [Unreleased] to [#{version}] section")
    UI.message("3. Commit the changelog changes")
  end

  desc "Clean build artifacts and temporary files"
  lane :clean do
    UI.message("🧹 Cleaning build artifacts...")
    
    # Clean Xcode build folder
    sh("xcodebuild clean -project '../LeavesOfBlocks.xcodeproj' -scheme 'LeavesOfBlocks'")
    
    # Remove fastlane build artifacts
    sh("rm -f ../*.ipa ../*.dSYM.zip")
    sh("rm -rf ./test_output ./report.xml")
    sh("rm -rf ./build_output")
    
    # Remove derived data if needed (optional, commented out by default)
    # sh("rm -rf ~/Library/Developer/Xcode/DerivedData/LeavesOfBlocks-*")
    
    UI.success("✨ Clean complete!")
  end

  after_all do |lane|
    # This block is called, only if the executed lane was successful
    notification(message: "Fastlane finished '#{lane}' successfully! 🎉")
  end

  error do |lane, exception|
    # This block is called, only if the executed lane failed
    notification(
      message: "Fastlane '#{lane}' failed with error: #{exception.message} ❌"
    )
  end
end
