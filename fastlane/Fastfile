# Import shared constants
require_relative 'Constants'

default_platform(:ios)

# Helper function to bump marketing version directly in Xcode project
# This works around issues with increment_version_number and agvtool
def bump_marketing_version(xcodeproj:, target_name:, bump_type:)
  require 'xcodeproj'

  # Fastlane runs from fastlane/ directory, so go up one level
  project_path = File.join(Dir.pwd, '..', xcodeproj)
  project = Xcodeproj::Project.open(project_path)

  # Find the target
  target = project.targets.find { |t| t.name == target_name }
  raise "Target '#{target_name}' not found" unless target

  # Get current version from Release configuration
  release_config = target.build_configurations.find { |c| c.name == 'Release' }
  current_version = release_config.build_settings['MARKETING_VERSION'] || '1.0.0'

  UI.message("Current version: #{current_version}")

  # Calculate new version
  parts = current_version.split('.').map(&:to_i)
  parts << 0 while parts.length < 3  # Ensure we have at least 3 parts

  new_version = case bump_type
  when "patch"
    "#{parts[0]}.#{parts[1]}.#{parts[2] + 1}"
  when "minor"
    "#{parts[0]}.#{parts[1] + 1}.0"
  when "major"
    "#{parts[0] + 1}.0.0"
  else
    # Assume it's a specific version number
    bump_type
  end

  # Update all configurations for the target
  target.build_configurations.each do |config|
    config.build_settings['MARKETING_VERSION'] = new_version
  end

  project.save

  UI.message("Version bumped: #{current_version} → #{new_version}")
  new_version
end

# Helper function to generate release notes from CHANGELOG.md
# Parses the changelog, extracts the section for the given version,
# and transforms it into a prose summary for App Store
def generate_release_notes(version:)
  changelog_path = File.join(Dir.pwd, '..', 'CHANGELOG.md')
  release_notes_path = File.join(Dir.pwd, 'metadata', 'en-US', 'release_notes.txt')

  unless File.exist?(changelog_path)
    UI.important("CHANGELOG.md not found, skipping release notes generation")
    return nil
  end

  content = File.read(changelog_path)

  # Try to find the section for this version, or fall back to [Unreleased]
  version_pattern = /## \[#{Regexp.escape(version)}\].*?\n(.*?)(?=\n## \[|\n\[Unreleased\]:|\z)/m
  unreleased_pattern = /## \[Unreleased\].*?\n(.*?)(?=\n## \[|\z)/m

  section = content.match(version_pattern)
  section = content.match(unreleased_pattern) if section.nil? || section[1].strip.empty?

  if section.nil? || section[1].strip.empty?
    UI.important("No changelog entries found for version #{version}")
    return nil
  end

  section_content = section[1]

  # Parse the different sections (Added, Changed, Fixed, etc.)
  added = extract_items(section_content, 'Added')
  changed = extract_items(section_content, 'Changed')
  fixed = extract_items(section_content, 'Fixed')
  improved = extract_items(section_content, 'Improved')

  # Build prose summary
  sentences = []

  # Added items
  if added.any?
    if added.length == 1
      sentences << "This update brings #{added.first.downcase}."
    else
      sentences << "This update brings #{added.first.downcase}."
      added[1..-1].each { |item| sentences << "We've also added #{item.downcase}." }
    end
  end

  # Changed/Improved items
  all_improvements = changed + improved
  if all_improvements.any?
    all_improvements.each { |item| sentences << "We've improved #{item.downcase}." }
  end

  # Fixed items
  if fixed.any?
    if fixed.length == 1
      sentences << "We've fixed #{fixed.first.downcase}."
    else
      sentences << "We've fixed #{fixed.first.downcase}."
      fixed[1..-1].each { |item| sentences << "Also fixed: #{item.downcase}." }
    end
  end

  # If no structured content found, use a generic message
  if sentences.empty?
    sentences << "This update includes various improvements and bug fixes."
  end

  # Add closing
  sentences << ""
  sentences << "Thank you for playing Leaves of Blocks!"

  prose = sentences.join(" ").gsub("  ", " ").strip
  # Fix double periods
  prose = prose.gsub("..", ".").gsub(". .", ".")

  # Ensure we don't exceed App Store's 4000 character limit
  if prose.length > 4000
    prose = prose[0..3950] + "...\n\nThank you for playing Leaves of Blocks!"
  end

  # Write to release_notes.txt
  File.write(release_notes_path, prose)
  UI.success("Release notes generated for version #{version}")
  UI.message("Preview:\n#{prose}")

  prose
end

# Helper to extract bullet items from a changelog section
def extract_items(content, header)
  pattern = /### #{header}\n((?:- .*\n?)*)/
  match = content.match(pattern)
  return [] unless match

  match[1].scan(/^- (.+)$/).flatten.map(&:strip).reject(&:empty?)
end

platform :ios do
  before_all do
    ensure_xcode_version(version: XCODE_VERSION)
  end

  desc "Run tests"
  lane :test do
    run_tests(
      project: XCODE_PROJECT,
      scheme: MAIN_SCHEME,
      destination: "platform=iOS Simulator,name=#{IOS_SIMULATOR}"
    )
  end

  desc "Build for testing"
  lane :build_for_testing do
    build_app(
      project: XCODE_PROJECT,
      scheme: MAIN_SCHEME,
      destination: "platform=iOS Simulator,name=#{IOS_SIMULATOR}",
      skip_archive: true,
      skip_codesigning: true
    )
  end

  desc "Create a new build for App Store"
  lane :build do
    increment_build_number(xcodeproj: XCODE_PROJECT)
    build_app(
      project: XCODE_PROJECT,
      scheme: MAIN_SCHEME,
      export_method: EXPORT_METHOD
    )
  end

  desc "Upload to TestFlight"
  lane :beta do
    # Configure App Store Connect API key for TestFlight
    api_key = app_store_api_key
    
    # Increment marketing version to create new release train
    increment_version_number(
      xcodeproj: XCODE_PROJECT,
      version_number: "1.0.3"  # Explicitly set new version to resolve closed train
    )
    increment_build_number(xcodeproj: XCODE_PROJECT)
    build_app(
      project: XCODE_PROJECT,
      scheme: MAIN_SCHEME,
      export_method: EXPORT_METHOD
    )
    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end

  desc "Upload to App Store"
  lane :release do
    # Configure App Store Connect API key for App Store
    api_key = app_store_api_key
    
    increment_build_number(xcodeproj: XCODE_PROJECT)
    build_app(
      project: XCODE_PROJECT,
      scheme: MAIN_SCHEME,
      export_method: EXPORT_METHOD
    )
    upload_to_app_store(
      api_key: api_key,
      force: true,
      submit_for_review: false
    )
  end

  desc "Upload metadata and screenshots only (no binary)"
  lane :metadata_only do
    # Configure App Store Connect API key for App Store
    api_key = app_store_api_key
    
    deliver(
      api_key: api_key,
      skip_binary_upload: true,
      skip_screenshots: false,
      skip_metadata: false,
      force: true
    )
  end

  desc "Upload screenshots only"
  lane :screenshots_only do
    # Configure App Store Connect API key for App Store
    api_key = app_store_api_key
    
    deliver(
      api_key: api_key,
      skip_binary_upload: true,
      skip_screenshots: false,
      skip_metadata: true,
      force: true
    )
  end

  desc "Complete App Store deployment with metadata and binary"
  desc "Options: version:patch|minor|major or version:1.0.5 to set specific version"
  lane :deploy do |options|
    # Set up API key in lane context (automatically used by deliver)
    api_key = app_store_api_key

    # Handle version increment if specified
    new_version = nil
    if options[:version]
      new_version = bump_marketing_version(
        xcodeproj: XCODE_PROJECT,
        target_name: MAIN_SCHEME,
        bump_type: options[:version]
      )
      UI.success("Marketing Version Updated to #{new_version}")

      # Generate release notes from CHANGELOG.md
      generate_release_notes(version: new_version)
    end

    # Increment build number
    increment_build_number(xcodeproj: XCODE_PROJECT)

    UI.success("Build Number Incremented")

    # Build the app
    build_app(
      project: XCODE_PROJECT,
      scheme: MAIN_SCHEME,
      export_method: EXPORT_METHOD
    )

    UI.success("Build App Complete")

    # Log API key info for debugging
    UI.message("🔑 API Key Info:")
    UI.message("  Key ID: #{api_key[:key_id]}")
    UI.message("  Issuer ID: #{api_key[:issuer_id]}")
    UI.message("  Key exists: #{api_key[:key] ? 'Yes' : 'No'}")

    # Upload everything using deliver (automatically uses API key from lane context)
    # Enable metadata upload to include generated release notes
    deliver(
      api_key: api_key,
      submit_for_review: false,
      automatic_release: false,
      force: true,
      skip_metadata: false
    )

    UI.success("🚀 App delivered to App Store Connect!")

    UI.message("📱 Binary, metadata, and screenshots uploaded")
    UI.message("⏳ Check App Store Connect for build processing status")
  end

  desc "Submit for App Store review (use after deploy)"
  lane :submit do
    # Configure App Store Connect API key for App Store
    api_key = app_store_api_key
    
    deliver(
      api_key: api_key,
      submit_for_review: true,
      automatic_release: false,
      force: true,
      skip_binary_upload: true,
      skip_metadata: true,
      skip_screenshots: true
    )
    
    UI.success("📝 App submitted for App Store review!")
  end

  desc "Full deployment pipeline: build, upload, and submit for review"
  desc "Options: version:patch|minor|major or version:1.0.5 to set specific version"
  lane :deploy_and_submit do |options|
    # Configure App Store Connect API key for App Store
    api_key = app_store_api_key

    # Handle version increment if specified
    new_version = nil
    if options[:version]
      new_version = bump_marketing_version(
        xcodeproj: XCODE_PROJECT,
        target_name: MAIN_SCHEME,
        bump_type: options[:version]
      )
      UI.success("Marketing Version Updated to #{new_version}")

      # Generate release notes from CHANGELOG.md
      generate_release_notes(version: new_version)
    end

    # Increment build number
    increment_build_number(xcodeproj: XCODE_PROJECT)

    # Build the app
    build_app(
      project: XCODE_PROJECT,
      scheme: MAIN_SCHEME,
      export_method: EXPORT_METHOD
    )

    # Upload everything and submit for review
    # Enable metadata upload to include generated release notes
    deliver(
      api_key: api_key,
      submit_for_review: true,
      automatic_release: false,
      force: true,
      skip_metadata: false,
      skip_waiting_for_build_processing: false
    )

    UI.success("🎉 Complete deployment finished!")
    UI.message("📱 Binary uploaded and submitted for review")
    UI.message("⏳ Apple will review your app within 24-48 hours")
  end

  desc "Generate new localized screenshots"
  lane :screenshots do
    # Build for testing first
    build_for_testing
    
    # Capture screenshots using snapshot (configuration from Snapfile)
    capture_screenshots(
      number_of_retries: 0
    )
    
    UI.success("✅ Screenshots captured successfully!")
    UI.message("📱 Find your screenshots in: fastlane/screenshots/")
    UI.message("📄 HTML report: fastlane/screenshots/screenshots.html")
  end

  desc "Generate manual screenshots (simulator only)"
  lane :manual_screenshots do
    UI.message("🚀 Building app for manual screenshot capture...")
    
    # Build the app for simulator
    build_for_testing
    
    UI.success("✅ App built successfully!")
    UI.message("📱 To capture screenshots manually:")
    UI.message("1. Open iOS Simulator")
    UI.message("2. Launch your app from Xcode or run: xcrun simctl launch booted #{APP_IDENTIFIER}")
    UI.message("3. Navigate through your app")
    UI.message("4. Press ⌘+S in Simulator to save screenshots")
    UI.message("5. Screenshots will be saved to ~/Desktop")
    UI.message("")
    UI.message("💡 Pro tip: Use ⌘+1, ⌘+2, ⌘+3 to switch device sizes quickly")
  end

  desc "Test App Store Connect API authentication"
  lane :test_api_auth do
    begin
      # Configure App Store Connect API key
      api_key = app_store_api_key
      
      UI.message("🔑 Testing App Store Connect API authentication...")
      
      # Try to fetch latest TestFlight build number to test API connection
      latest_testflight_build_number(
        api_key: api_key,
        app_identifier: APP_IDENTIFIER
      )
      
      UI.success("✅ API authentication successful!")
      UI.message("🎉 Your App Store Connect API key is working correctly")
      
    rescue => exception
      UI.error("❌ API authentication failed:")
      UI.error("Error: #{exception.message}")
      UI.message("💡 Check your API key configuration in fastlane/Constants.rb")
      raise exception
    end
  end


  desc "Clean build artifacts and temporary files"
  lane :clean do
    UI.message("🧹 Cleaning build artifacts...")
    
    # Clean Xcode build folder
    sh("xcodebuild clean -project '../#{XCODE_PROJECT}' -scheme '#{MAIN_SCHEME}'")
    
    # Remove fastlane build artifacts
    sh("rm -f ../*.ipa ../*.dSYM.zip")
    sh("rm -rf ./test_output ./report.xml")
    sh("rm -rf ./build_output")
    
    # Remove derived data if needed (optional, commented out by default)
    # sh("rm -rf ~/Library/Developer/Xcode/DerivedData/LeavesOfBlocks-*")
    
    UI.success("✨ Clean complete!")
  end

  after_all do |lane|
    # This block is called, only if the executed lane was successful
    notification(message: "Fastlane finished '#{lane}' successfully! 🎉")
  end

  error do |lane, exception|
    # This block is called, only if the executed lane failed
    notification(
      message: "Fastlane '#{lane}' failed with error: #{exception.message} ❌"
    )
  end
end
