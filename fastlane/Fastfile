# This file contains the fastlane.tools configuration
# You can find the documentation at https://docs.fastlane.tools
#
# For a list of all available actions, check out
#
#     https://docs.fastlane.tools/actions
#
# For a list of all available plugins, check out
#
#     https://docs.fastlane.tools/plugins/available-plugins
#

# Uncomment the line if you want fastlane to automatically update itself
# update_fastlane

# Import shared constants
require_relative 'Constants'

default_platform(:ios)

platform :ios do
  before_all do
    ensure_xcode_version(version: XCODE_VERSION)
  end

  desc "Run tests"
  lane :test do
    run_tests(
      project: XCODE_PROJECT,
      scheme: MAIN_SCHEME,
      destination: "platform=iOS Simulator,name=#{IOS_SIMULATOR}"
    )
  end

  desc "Build for testing"
  lane :build_for_testing do
    build_app(
      project: XCODE_PROJECT,
      scheme: MAIN_SCHEME,
      destination: "platform=iOS Simulator,name=#{IOS_SIMULATOR}",
      skip_archive: true,
      skip_codesigning: true
    )
  end

  desc "Create a new build for App Store"
  lane :build do
    increment_build_number(xcodeproj: XCODE_PROJECT)
    build_app(
      project: XCODE_PROJECT,
      scheme: MAIN_SCHEME,
      export_method: EXPORT_METHOD
    )
  end

  desc "Upload to TestFlight"
  lane :beta do
    # Configure App Store Connect API key for TestFlight
    api_key = app_store_api_key
    
    # Increment marketing version to create new release train
    increment_version_number(
      xcodeproj: XCODE_PROJECT,
      version_number: "1.0.3"  # Explicitly set new version to resolve closed train
    )
    increment_build_number(xcodeproj: XCODE_PROJECT)
    build_app(
      project: XCODE_PROJECT,
      scheme: MAIN_SCHEME,
      export_method: EXPORT_METHOD
    )
    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end

  desc "Upload to App Store"
  lane :release do
    # Configure App Store Connect API key for App Store
    api_key = app_store_api_key
    
    increment_build_number(xcodeproj: XCODE_PROJECT)
    build_app(
      project: XCODE_PROJECT,
      scheme: MAIN_SCHEME,
      export_method: EXPORT_METHOD
    )
    upload_to_app_store(
      api_key: api_key,
      force: true,
      submit_for_review: false
    )
  end

  desc "Upload metadata and screenshots only (no binary)"
  lane :metadata_only do
    # Configure App Store Connect API key for App Store
    api_key = app_store_api_key
    
    deliver(
      api_key: api_key,
      skip_binary_upload: true,
      skip_screenshots: false,
      skip_metadata: false,
      force: true
    )
  end

  desc "Upload screenshots only"
  lane :screenshots_only do
    # Configure App Store Connect API key for App Store
    api_key = app_store_api_key
    
    deliver(
      api_key: api_key,
      skip_binary_upload: true,
      skip_screenshots: false,
      skip_metadata: true,
      force: true
    )
  end

  desc "Complete App Store deployment with metadata and binary"
  lane :deploy do
    # Set up API key in lane context (automatically used by deliver)
    api_key = app_store_api_key

    # Increment build number
    increment_build_number(xcodeproj: XCODE_PROJECT)
    
    UI.success("Build Number Incremented")

    # Build the app
    build_app(
      project: XCODE_PROJECT,
      scheme: MAIN_SCHEME,
      export_method: EXPORT_METHOD
    )
    
    UI.success("Build App Complete")

    # Log API key info for debugging
    UI.message("🔑 API Key Info:")
    UI.message("  Key ID: #{api_key[:key_id]}")
    UI.message("  Issuer ID: #{api_key[:issuer_id]}")
    UI.message("  Key exists: #{api_key[:key] ? 'Yes' : 'No'}")

    # Upload everything using deliver (automatically uses API key from lane context)
    deliver(
      api_key: api_key,
      submit_for_review: false,
      automatic_release: false,
      force: true
    )
    
    UI.success("🚀 App delivered to App Store Connect!")

    UI.message("📱 Binary, metadata, and screenshots uploaded")
    UI.message("⏳ Check App Store Connect for build processing status")
  end

  desc "Submit for App Store review (use after deploy)"
  lane :submit do
    # Configure App Store Connect API key for App Store
    api_key = app_store_api_key
    
    deliver(
      api_key: api_key,
      submit_for_review: true,
      automatic_release: false,
      force: true,
      skip_binary_upload: true,
      skip_metadata: true,
      skip_screenshots: true
    )
    
    UI.success("📝 App submitted for App Store review!")
  end

  desc "Full deployment pipeline: build, upload, and submit for review"
  lane :deploy_and_submit do
    # Configure App Store Connect API key for App Store
    api_key = app_store_api_key
    
    # Increment build number
    increment_build_number(xcodeproj: XCODE_PROJECT)
    
    # Build the app
    build_app(
      project: XCODE_PROJECT,
      scheme: MAIN_SCHEME,
      export_method: EXPORT_METHOD
    )
    
    # Upload everything and submit for review
    deliver(
      api_key: api_key,
      submit_for_review: true,
      automatic_release: false,
      force: true,
      skip_waiting_for_build_processing: false
    )
    
    UI.success("🎉 Complete deployment finished!")
    UI.message("📱 Binary uploaded and submitted for review")
    UI.message("⏳ Apple will review your app within 24-48 hours")
  end

  desc "Generate new localized screenshots"
  lane :screenshots do
    # Build for testing first
    build_for_testing
    
    # Capture screenshots using snapshot (configuration from Snapfile)
    capture_screenshots(
      number_of_retries: 0
    )
    
    UI.success("✅ Screenshots captured successfully!")
    UI.message("📱 Find your screenshots in: fastlane/screenshots/")
    UI.message("📄 HTML report: fastlane/screenshots/screenshots.html")
  end

  desc "Generate manual screenshots (simulator only)"
  lane :manual_screenshots do
    UI.message("🚀 Building app for manual screenshot capture...")
    
    # Build the app for simulator
    build_for_testing
    
    UI.success("✅ App built successfully!")
    UI.message("📱 To capture screenshots manually:")
    UI.message("1. Open iOS Simulator")
    UI.message("2. Launch your app from Xcode or run: xcrun simctl launch booted #{APP_IDENTIFIER}")
    UI.message("3. Navigate through your app")
    UI.message("4. Press ⌘+S in Simulator to save screenshots")
    UI.message("5. Screenshots will be saved to ~/Desktop")
    UI.message("")
    UI.message("💡 Pro tip: Use ⌘+1, ⌘+2, ⌘+3 to switch device sizes quickly")
  end

  desc "Test App Store Connect API authentication"
  lane :test_api_auth do
    begin
      # Configure App Store Connect API key
      api_key = app_store_api_key
      
      UI.message("🔑 Testing App Store Connect API authentication...")
      
      # Try to fetch latest TestFlight build number to test API connection
      latest_testflight_build_number(
        api_key: api_key,
        app_identifier: APP_IDENTIFIER
      )
      
      UI.success("✅ API authentication successful!")
      UI.message("🎉 Your App Store Connect API key is working correctly")
      
    rescue => exception
      UI.error("❌ API authentication failed:")
      UI.error("Error: #{exception.message}")
      UI.message("💡 Check your API key configuration in fastlane/Constants.rb")
      raise exception
    end
  end


  desc "Clean build artifacts and temporary files"
  lane :clean do
    UI.message("🧹 Cleaning build artifacts...")
    
    # Clean Xcode build folder
    sh("xcodebuild clean -project '../#{XCODE_PROJECT}' -scheme '#{MAIN_SCHEME}'")
    
    # Remove fastlane build artifacts
    sh("rm -f ../*.ipa ../*.dSYM.zip")
    sh("rm -rf ./test_output ./report.xml")
    sh("rm -rf ./build_output")
    
    # Remove derived data if needed (optional, commented out by default)
    # sh("rm -rf ~/Library/Developer/Xcode/DerivedData/LeavesOfBlocks-*")
    
    UI.success("✨ Clean complete!")
  end

  after_all do |lane|
    # This block is called, only if the executed lane was successful
    notification(message: "Fastlane finished '#{lane}' successfully! 🎉")
  end

  error do |lane, exception|
    # This block is called, only if the executed lane failed
    notification(
      message: "Fastlane '#{lane}' failed with error: #{exception.message} ❌"
    )
  end
end
