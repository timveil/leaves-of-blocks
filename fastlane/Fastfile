# Import shared constants and AI helper. `require_relative` fails under
# fastlane's eval-based loader on Ruby 3.x+ ("cannot infer basepath"), so
# resolve the fastlane dir from Dir.pwd and use `require` (idempotent —
# `load` would reassign top-level constants on each fastlane pass and emit
# "already initialized constant" warnings).
fastlane_dir = ['fastlane', '.']
  .map { |d| File.expand_path(d, Dir.pwd) }
  .find { |d| File.exist?(File.join(d, 'Constants.rb')) }
require File.join(fastlane_dir, 'Constants')
require File.join(fastlane_dir, 'AIHelper')
require File.join(fastlane_dir, 'GameCenterConfig')
require File.join(fastlane_dir, 'GameCenterClient')

default_platform(:ios)

# Helper function to bump marketing version directly in Xcode project
# This works around issues with increment_version_number and agvtool
def bump_marketing_version(xcodeproj:, target_name:, bump_type:)
  require 'xcodeproj'

  # Fastlane runs from fastlane/ directory, so go up one level
  project_path = File.join(Dir.pwd, '..', xcodeproj)
  project = Xcodeproj::Project.open(project_path)

  # Find the target
  target = project.targets.find { |t| t.name == target_name }
  raise "Target '#{target_name}' not found" unless target

  # Get current version from Release configuration
  release_config = target.build_configurations.find { |c| c.name == 'Release' }
  current_version = release_config.build_settings['MARKETING_VERSION'] || '1.0.0'

  UI.message("Current version: #{current_version}")

  # Calculate new version
  parts = current_version.split('.').map(&:to_i)
  parts << 0 while parts.length < 3  # Ensure we have at least 3 parts

  new_version = case bump_type
  when "patch"
    "#{parts[0]}.#{parts[1]}.#{parts[2] + 1}"
  when "minor"
    "#{parts[0]}.#{parts[1] + 1}.0"
  when "major"
    "#{parts[0] + 1}.0.0"
  else
    # Assume it's a specific version number
    bump_type
  end

  # Update all configurations for the target
  target.build_configurations.each do |config|
    config.build_settings['MARKETING_VERSION'] = new_version
  end

  project.save

  UI.message("Version bumped: #{current_version} → #{new_version}")
  new_version
end

# Helper function to generate release notes from CHANGELOG.md
# Parses the changelog, extracts the section for the given version,
# and transforms it into a prose summary for App Store
# Uses AI enhancement when ANTHROPIC_API_KEY is available
def generate_release_notes(version:)
  changelog_path = File.join(Dir.pwd, '..', 'CHANGELOG.md')
  release_notes_path = File.join(Dir.pwd, 'metadata', 'en-US', 'release_notes.txt')

  unless File.exist?(changelog_path)
    UI.important("CHANGELOG.md not found, skipping release notes generation")
    return nil
  end

  content = File.read(changelog_path)

  # Try to find the section for this version, or fall back to [Unreleased]
  version_pattern = /## \[#{Regexp.escape(version)}\].*?\n(.*?)(?=\n## \[|\n\[Unreleased\]:|\z)/m
  unreleased_pattern = /## \[Unreleased\].*?\n(.*?)(?=\n## \[|\z)/m

  section = content.match(version_pattern)
  section = content.match(unreleased_pattern) if section.nil? || section[1].strip.empty?

  if section.nil? || section[1].strip.empty?
    UI.important("No changelog entries found for version #{version}")
    return nil
  end

  section_content = section[1]

  # === AI PROSE GENERATION ATTEMPT ===
  prose = nil
  if AIHelper.available?
    UI.message("Attempting AI-generated release notes...")
    prose = AIHelper.generate_prose(changelog_section: section_content, version: version)

    if prose
      UI.success("AI prose generation successful")
    else
      UI.message("AI prose generation returned no results, using fallback")
    end
  else
    UI.message("ANTHROPIC_API_KEY not set, using template-based release notes")
  end

  # === FALLBACK: Template-based generation ===
  unless prose
    # Parse the different sections (Added, Changed, Fixed, etc.)
    added = extract_items(section_content, 'Added')
    changed = extract_items(section_content, 'Changed')
    fixed = extract_items(section_content, 'Fixed')
    improved = extract_items(section_content, 'Improved')

    # Build prose summary
    sentences = []

    # Added items
    if added.any?
      if added.length == 1
        sentences << "This update brings #{added.first.downcase}."
      else
        sentences << "This update brings #{added.first.downcase}."
        added[1..-1].each { |item| sentences << "We've also added #{item.downcase}." }
      end
    end

    # Changed/Improved items
    all_improvements = changed + improved
    if all_improvements.any?
      all_improvements.each { |item| sentences << "We've improved #{item.downcase}." }
    end

    # Fixed items
    if fixed.any?
      if fixed.length == 1
        sentences << "We've fixed #{fixed.first.downcase}."
      else
        sentences << "We've fixed #{fixed.first.downcase}."
        fixed[1..-1].each { |item| sentences << "Also fixed: #{item.downcase}." }
      end
    end

    # If no structured content found, use a generic message
    if sentences.empty?
      sentences << "This update includes various improvements and bug fixes."
    end

    # Add closing
    sentences << ""
    sentences << "Thank you for playing Leaves of Blocks!"

    prose = sentences.join(" ").gsub("  ", " ").strip
    # Fix double periods
    prose = prose.gsub("..", ".").gsub(". .", ".")
  end

  # Ensure we don't exceed App Store's 4000 character limit
  if prose.length > 4000
    prose = prose[0..3950] + "...\n\nThank you for playing Leaves of Blocks!"
  end

  # Write to release_notes.txt
  File.write(release_notes_path, prose)
  UI.success("Release notes generated for version #{version}")
  UI.message("Preview:\n#{prose}")

  prose
end

# Helper to extract bullet items from a changelog section
def extract_items(content, header)
  pattern = /### #{header}\n((?:- .*\n?)*)/
  match = content.match(pattern)
  return [] unless match

  match[1].scan(/^- (.+)$/).flatten.map(&:strip).reject(&:empty?)
end

# Calculate new version without applying it
def calculate_new_version(xcodeproj:, target_name:, bump_type:)
  require 'xcodeproj'

  project_path = File.join(Dir.pwd, '..', xcodeproj)
  project = Xcodeproj::Project.open(project_path)

  target = project.targets.find { |t| t.name == target_name }
  raise "Target '#{target_name}' not found" unless target

  release_config = target.build_configurations.find { |c| c.name == 'Release' }
  current_version = release_config.build_settings['MARKETING_VERSION'] || '1.0.0'

  parts = current_version.split('.').map(&:to_i)
  parts << 0 while parts.length < 3

  case bump_type
  when "patch"
    "#{parts[0]}.#{parts[1]}.#{parts[2] + 1}"
  when "minor"
    "#{parts[0]}.#{parts[1] + 1}.0"
  when "major"
    "#{parts[0] + 1}.0.0"
  else
    bump_type
  end
end

# Format a changelog section with items
def format_changelog_section(header, items)
  return "" if items.empty?
  section = "\n### #{header}\n"
  items.each { |item| section += "- #{item}\n" }
  section
end

# Update CHANGELOG.md from git commits since last tag
# Returns the changelog section content for release notes
# Uses AI enhancement when ANTHROPIC_API_KEY is available
def update_changelog_from_commits(new_version:)
  changelog_path = File.join(Dir.pwd, '..', 'CHANGELOG.md')

  # Find last version tag
  last_tag = `git describe --tags --abbrev=0 2>/dev/null`.strip

  if last_tag.empty?
    UI.message("No previous tags found, using all commits")
    range = ""
  else
    UI.message("Finding commits since #{last_tag}")
    range = "#{last_tag}..HEAD"
  end

  # Get commits since last tag
  commits = `git log #{range} --pretty=format:"%s"`.split("\n")
  UI.message("Found #{commits.length} commits to process")

  # Filter out release commits before processing
  filtered_commits = commits.reject { |c| c.match?(/^chore: Release v/i) }
  UI.message("#{filtered_commits.length} commits after filtering release commits")

  # === AI ENHANCEMENT ATTEMPT ===
  ai_result = nil
  if AIHelper.available?
    UI.message("Attempting AI-enhanced changelog generation...")
    ai_result = AIHelper.enhance_changelog(commits: filtered_commits, new_version: new_version)

    if ai_result
      UI.success("AI enhancement successful")
    else
      UI.message("AI enhancement returned no results, using fallback")
    end
  else
    UI.message("ANTHROPIC_API_KEY not set, using template-based generation")
  end

  # === CATEGORIZE COMMITS ===
  if ai_result
    added = ai_result[:added]
    changed = ai_result[:changed]
    fixed = ai_result[:fixed]
    removed = ai_result[:removed]
  else
    # FALLBACK: Existing regex-based parsing
    added = []
    changed = []
    fixed = []
    removed = []

    filtered_commits.each do |msg|
      case msg
      when /^feat(\(.+\))?:\s*(.+)/i
        added << $2.strip.capitalize
      when /^fix(\(.+\))?:\s*(.+)/i
        fixed << $2.strip.capitalize
      when /^(refactor|perf|style)(\(.+\))?:\s*(.+)/i
        changed << $3.strip.capitalize
      when /^(remove|revert)(\(.+\))?:\s*(.+)/i
        removed << $3.strip.capitalize
      # Fallback for non-conventional commits - detect intent from message start
      when /^Add\s+(.+)/i
        added << $1.strip.capitalize
      when /^Fix\s+(.+)/i
        fixed << $1.strip.capitalize
      when /^(Update|Improve|Enhance|Refactor)\s+(.+)/i
        changed << $2.strip.capitalize
      when /^(Remove|Delete|Revert)\s+(.+)/i
        removed << $1.strip.capitalize
      end
    end
  end

  # Remove duplicates
  added.uniq!
  changed.uniq!
  fixed.uniq!
  removed.uniq!

  # Block if no meaningful changes
  if added.empty? && changed.empty? && fixed.empty? && removed.empty?
    UI.user_error!(
      "No changelog entries found from commits.\n\n" +
      "Use conventional commits for automatic changelog generation:\n" +
      "  feat: Add new feature\n" +
      "  fix: Fix a bug\n" +
      "  refactor: Refactor code\n" +
      "  perf: Improve performance\n\n" +
      "Or use descriptive prefixes: Add, Fix, Update, Improve, Remove"
    )
  end

  # Build changelog section
  date = Time.now.strftime("%Y-%m-%d")
  section = "## [#{new_version}] - #{date}\n"
  section += format_changelog_section("Added", added)
  section += format_changelog_section("Changed", changed)
  section += format_changelog_section("Fixed", fixed)
  section += format_changelog_section("Removed", removed)

  # Read existing changelog
  unless File.exist?(changelog_path)
    UI.user_error!("CHANGELOG.md not found at #{changelog_path}")
  end

  content = File.read(changelog_path)

  # Insert new section after [Unreleased] header
  # Find the [Unreleased] section and insert after it
  unreleased_pattern = /(## \[Unreleased\].*?(?:\n### \w+\n)*\n*)/m

  if content.match?(unreleased_pattern)
    # Insert new version section after Unreleased section
    new_content = content.sub(unreleased_pattern) do |match|
      # Reset the Unreleased section and add new version
      "## [Unreleased]\n\n### Added\n\n### Changed\n\n### Fixed\n\n#{section}"
    end
  else
    # No Unreleased section, insert at top after header
    header_end = content.index("\n## [") || content.length
    new_content = content[0...header_end] + "\n\n## [Unreleased]\n\n### Added\n\n### Changed\n\n### Fixed\n\n#{section}" + content[header_end..-1].to_s
  end

  # Update footer links
  # Add new version link if not present
  repo_url = "https://github.com/timveil/leaves-of-blocks"

  # Update [Unreleased] link
  new_content.gsub!(
    /\[Unreleased\]: .+/,
    "[Unreleased]: #{repo_url}/compare/v#{new_version}...HEAD"
  )

  # Add new version link if not present
  version_link = "[#{new_version}]: #{repo_url}/compare/"
  unless new_content.include?(version_link)
    # Find previous version from existing links
    prev_version_match = new_content.match(/\[(\d+\.\d+\.\d+)\]: /)
    if prev_version_match
      prev_version = prev_version_match[1]
      new_link = "[#{new_version}]: #{repo_url}/compare/v#{prev_version}...v#{new_version}\n"
      # Insert after Unreleased link
      new_content.sub!(/(\[Unreleased\]: .+\n)/, "\\1#{new_link}")
    else
      # No previous version, link to tag
      new_link = "[#{new_version}]: #{repo_url}/releases/tag/v#{new_version}\n"
      new_content.sub!(/(\[Unreleased\]: .+\n)/, "\\1#{new_link}")
    end
  end

  # Write updated changelog
  File.write(changelog_path, new_content)
  UI.success("CHANGELOG.md updated with version #{new_version}")

  # Return the section for release notes generation
  section
end

# Commit changelog and project changes, then create git tag
def commit_release(version:)
  # Stage changelog and metadata
  sh("git add ../CHANGELOG.md")
  sh("git add metadata/en-US/release_notes.txt")
  sh("git add ../LeavesOfBlocks.xcodeproj/project.pbxproj")

  # Commit with conventional commit format
  sh("git commit -m 'chore: Release v#{version}'")

  # Create annotated tag
  sh("git tag -a v#{version} -m 'Release version #{version}'")

  # Push commit and tag to remote
  sh("git push origin HEAD")
  sh("git push origin v#{version}")

  UI.success("Created and pushed commit and tag v#{version}")
end

platform :ios do
  before_all do
    ensure_xcode_version(version: XCODE_VERSION)
  end

  desc "Run tests"
  lane :test do
    run_tests(
      project: XCODE_PROJECT,
      scheme: MAIN_SCHEME,
      destination: "platform=iOS Simulator,name=#{IOS_SIMULATOR}"
    )
  end

  desc "Build for testing"
  lane :build_for_testing do
    build_app(
      project: XCODE_PROJECT,
      scheme: MAIN_SCHEME,
      destination: "platform=iOS Simulator,name=#{IOS_SIMULATOR}",
      skip_archive: true,
      skip_codesigning: true
    )
  end

  desc "Create a new build for App Store"
  lane :build do
    api_key = app_store_api_key
    increment_build_number(xcodeproj: XCODE_PROJECT)
    build_app(
      project: XCODE_PROJECT,
      scheme: MAIN_SCHEME,
      export_method: EXPORT_METHOD,
      export_options: app_store_signing_options(api_key: api_key)
    )
  end

  desc "Upload to TestFlight"
  lane :beta do
    # Configure App Store Connect API key for TestFlight
    api_key = app_store_api_key
    
    # Set marketing version directly via xcodeproj gem. fastlane's
    # increment_version_number shells out to agvtool, which fails to write
    # MARKETING_VERSION when GENERATE_INFOPLIST_FILE=YES (it tries to update
    # an Info.plist that doesn't exist as a file and aborts before persisting
    # the project setting), silently leaving the old version on the build.
    bump_marketing_version(
      xcodeproj: XCODE_PROJECT,
      target_name: MAIN_SCHEME,
      bump_type: "2.0.0"  # 2.0 release train; change when starting the next major
    )
    increment_build_number(xcodeproj: XCODE_PROJECT)
    build_app(
      project: XCODE_PROJECT,
      scheme: MAIN_SCHEME,
      export_method: EXPORT_METHOD,
      export_options: app_store_signing_options(api_key: api_key)
    )
    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end

  desc "Upload to App Store"
  lane :release do
    # Configure App Store Connect API key for App Store
    api_key = app_store_api_key
    
    increment_build_number(xcodeproj: XCODE_PROJECT)
    build_app(
      project: XCODE_PROJECT,
      scheme: MAIN_SCHEME,
      export_method: EXPORT_METHOD,
      export_options: app_store_signing_options(api_key: api_key)
    )
    upload_to_app_store(
      api_key: api_key,
      force: true,
      submit_for_review: false
    )
  end

  desc "Upload metadata and screenshots only (no binary)"
  lane :metadata_only do
    # Configure App Store Connect API key for App Store
    api_key = app_store_api_key
    
    deliver(
      api_key: api_key,
      skip_binary_upload: true,
      skip_screenshots: false,
      skip_metadata: false,
      force: true
    )
  end

  desc "Upload screenshots only"
  lane :screenshots_only do
    # Configure App Store Connect API key for App Store
    api_key = app_store_api_key
    
    deliver(
      api_key: api_key,
      skip_binary_upload: true,
      skip_screenshots: false,
      skip_metadata: true,
      force: true
    )
  end

  desc "Complete App Store deployment with metadata and binary"
  desc "Options: version:patch|minor|major or version:1.0.5 to set specific version"
  lane :deploy do |options|
    # Set up API key in lane context (automatically used by deliver)
    api_key = app_store_api_key

    # Ensure we have a version bump specified
    unless options[:version]
      UI.user_error!("Version bump required. Use: fastlane deploy version:patch|minor|major")
    end

    # Calculate new version first (don't apply yet)
    new_version = calculate_new_version(
      xcodeproj: XCODE_PROJECT,
      target_name: MAIN_SCHEME,
      bump_type: options[:version]
    )
    UI.message("Preparing release for version #{new_version}")

    # Update changelog from commits (blocks if no meaningful commits)
    update_changelog_from_commits(new_version: new_version)

    # Now bump version in Xcode project
    bump_marketing_version(
      xcodeproj: XCODE_PROJECT,
      target_name: MAIN_SCHEME,
      bump_type: options[:version]
    )
    UI.success("Marketing Version Updated to #{new_version}")

    # Generate release notes from the updated changelog
    generate_release_notes(version: new_version)

    # Increment build number (before commit so it's included)
    increment_build_number(xcodeproj: XCODE_PROJECT)
    UI.success("Build Number Incremented")

    # Commit changelog, release notes, and project changes (including build number)
    commit_release(version: new_version)

    # Build the app
    build_app(
      project: XCODE_PROJECT,
      scheme: MAIN_SCHEME,
      export_method: EXPORT_METHOD,
      export_options: app_store_signing_options(api_key: api_key)
    )

    UI.success("Build App Complete")

    # Log API key info for debugging
    UI.message("🔑 API Key Info:")
    UI.message("  Key ID: #{api_key[:key_id]}")
    UI.message("  Issuer ID: #{api_key[:issuer_id]}")
    UI.message("  Key exists: #{api_key[:key] ? 'Yes' : 'No'}")

    # Upload everything using deliver (automatically uses API key from lane context)
    # Enable metadata upload to include generated release notes
    deliver(
      api_key: api_key,
      submit_for_review: false,
      automatic_release: false,
      force: true,
      skip_metadata: false
    )

    UI.success("🚀 App delivered to App Store Connect!")

    UI.message("📱 Binary, metadata, and screenshots uploaded")
    UI.message("🏷️  Git tag v#{new_version} created")
    UI.message("⏳ Check App Store Connect for build processing status")
  end

  desc "Submit for App Store review (use after deploy)"
  lane :submit do
    # Configure App Store Connect API key for App Store
    api_key = app_store_api_key
    
    deliver(
      api_key: api_key,
      submit_for_review: true,
      automatic_release: false,
      force: true,
      skip_binary_upload: true,
      skip_metadata: true,
      skip_screenshots: true
    )
    
    UI.success("📝 App submitted for App Store review!")
  end

  desc "Full deployment pipeline: build, upload, and submit for review"
  desc "Options: version:patch|minor|major or version:1.0.5 to set specific version"
  lane :deploy_and_submit do |options|
    # Configure App Store Connect API key for App Store
    api_key = app_store_api_key

    # Ensure we have a version bump specified
    unless options[:version]
      UI.user_error!("Version bump required. Use: fastlane deploy_and_submit version:patch|minor|major")
    end

    # Calculate new version first (don't apply yet)
    new_version = calculate_new_version(
      xcodeproj: XCODE_PROJECT,
      target_name: MAIN_SCHEME,
      bump_type: options[:version]
    )
    UI.message("Preparing release for version #{new_version}")

    # Update changelog from commits (blocks if no meaningful commits)
    update_changelog_from_commits(new_version: new_version)

    # Now bump version in Xcode project
    bump_marketing_version(
      xcodeproj: XCODE_PROJECT,
      target_name: MAIN_SCHEME,
      bump_type: options[:version]
    )
    UI.success("Marketing Version Updated to #{new_version}")

    # Generate release notes from the updated changelog
    generate_release_notes(version: new_version)

    # Increment build number (before commit so it's included)
    increment_build_number(xcodeproj: XCODE_PROJECT)

    # Commit changelog, release notes, and project changes (including build number)
    commit_release(version: new_version)

    # Build the app
    build_app(
      project: XCODE_PROJECT,
      scheme: MAIN_SCHEME,
      export_method: EXPORT_METHOD,
      export_options: app_store_signing_options(api_key: api_key)
    )

    # Upload everything and submit for review
    # Enable metadata upload to include generated release notes
    deliver(
      api_key: api_key,
      submit_for_review: true,
      automatic_release: false,
      force: true,
      skip_metadata: false,
      skip_waiting_for_build_processing: false
    )

    UI.success("🎉 Complete deployment finished!")
    UI.message("📱 Binary uploaded and submitted for review")
    UI.message("🏷️  Git tag v#{new_version} created")
    UI.message("⏳ Apple will review your app within 24-48 hours")
  end

  desc "Generate new localized screenshots"
  lane :screenshots do
    # Build for testing first
    build_for_testing

    # Capture screenshots using snapshot (configuration from Snapfile).
    # Restrict to the dedicated screenshot test so unrelated gameplay UI
    # tests don't run as part of asset generation.
    capture_screenshots(
      number_of_retries: 0,
      only_testing: ["LeavesOfBlocksUITests/LeavesOfBlocksUITests/testCaptureScreenshots"]
    )
    
    UI.success("✅ Screenshots captured successfully!")
    UI.message("📱 Find your screenshots in: fastlane/screenshots/")
    UI.message("📄 HTML report: fastlane/screenshots/screenshots.html")
  end

  desc "Generate manual screenshots (simulator only)"
  lane :manual_screenshots do
    UI.message("🚀 Building app for manual screenshot capture...")
    
    # Build the app for simulator
    build_for_testing
    
    UI.success("✅ App built successfully!")
    UI.message("📱 To capture screenshots manually:")
    UI.message("1. Open iOS Simulator")
    UI.message("2. Launch your app from Xcode or run: xcrun simctl launch booted #{APP_IDENTIFIER}")
    UI.message("3. Navigate through your app")
    UI.message("4. Press ⌘+S in Simulator to save screenshots")
    UI.message("5. Screenshots will be saved to ~/Desktop")
    UI.message("")
    UI.message("💡 Pro tip: Use ⌘+1, ⌘+2, ⌘+3 to switch device sizes quickly")
  end

  desc "Test App Store Connect API authentication"
  lane :test_api_auth do
    begin
      # Configure App Store Connect API key
      api_key = app_store_api_key
      
      UI.message("🔑 Testing App Store Connect API authentication...")
      
      # Try to fetch latest TestFlight build number to test API connection
      latest_testflight_build_number(
        api_key: api_key,
        app_identifier: APP_IDENTIFIER
      )
      
      UI.success("✅ API authentication successful!")
      UI.message("🎉 Your App Store Connect API key is working correctly")
      
    rescue => exception
      UI.error("❌ API authentication failed:")
      UI.error("Error: #{exception.message}")
      UI.message("💡 Check your API key configuration in fastlane/Constants.rb")
      raise exception
    end
  end


  desc "Create or verify Game Center leaderboards and achievements in App Store Connect"
  desc "Reads from fastlane/GameCenterConfig.rb. Idempotent — entries with matching"
  desc "vendor identifiers are skipped; new entries are POSTed via the App Store"
  desc "Connect API. fastlane has no native action for this; see issue #9082."
  lane :setup_game_center do
    api_key = app_store_api_key

    token = Spaceship::ConnectAPI.token
    UI.user_error!("Could not load App Store Connect token — check your API key configuration") unless token

    client = GameCenterClient.new(jwt: token.text)

    UI.message("🎮 Looking up app #{GameCenterConfig::BUNDLE_ID}...")
    app = client.find_app(bundle_id: GameCenterConfig::BUNDLE_ID)
    app_id = app.fetch('id')
    UI.success("  → app id #{app_id}")

    UI.message("🎮 Resolving Game Center detail...")
    detail = client.get_or_create_game_center_detail(app_id: app_id)
    detail_id = detail.fetch('id')
    UI.success("  → gameCenterDetail id #{detail_id}")

    # MARK: - Leaderboards

    UI.message("🏁 Reconciling #{GameCenterConfig::LEADERBOARDS.size} leaderboard(s)...")
    existing_leaderboards = client.list_leaderboards(detail_id: detail_id)
    by_vendor = existing_leaderboards.each_with_object({}) do |lb, acc|
      vid = lb.dig('attributes', 'vendorIdentifier')
      acc[vid] = lb if vid
    end

    leaderboard_summary = []
    GameCenterConfig::LEADERBOARDS.each do |definition|
      vid = definition[:vendor_identifier]
      if (existing = by_vendor[vid])
        lb_id = existing['id']
        existing_locales = client.list_leaderboard_localizations(leaderboard_id: lb_id)
                                 .map { |l| l.dig('attributes', 'locale') }.compact
        missing = definition[:localizations].reject { |loc| existing_locales.include?(loc[:locale]) }
        if missing.empty?
          UI.message("  ↺ #{vid} already exists (id #{lb_id}) — skipping")
        else
          UI.message("  ↺ #{vid} already exists (id #{lb_id}) — adding #{missing.size} missing localization(s)")
          missing.each do |loc|
            UI.message("    ＋ Localization #{loc[:locale]}")
            client.create_leaderboard_localization(leaderboard_id: lb_id, definition: loc)
          end
        end
        leaderboard_summary << [vid, lb_id, 'kept']
        next
      end

      UI.message("  ＋ Creating leaderboard #{vid}")
      created = client.create_leaderboard(detail_id: detail_id, definition: definition)
      lb_id = created.fetch('id')

      definition[:localizations].each do |loc|
        UI.message("    ＋ Localization #{loc[:locale]}")
        client.create_leaderboard_localization(leaderboard_id: lb_id, definition: loc)
      end

      leaderboard_summary << [vid, lb_id, 'created']
    end

    # MARK: - Achievements

    UI.message("🏆 Reconciling #{GameCenterConfig::ACHIEVEMENTS.size} achievement(s)...")
    existing_achievements = client.list_achievements(detail_id: detail_id)
    ach_by_vendor = existing_achievements.each_with_object({}) do |a, acc|
      vid = a.dig('attributes', 'vendorIdentifier')
      acc[vid] = a if vid
    end

    achievement_summary = []
    GameCenterConfig::ACHIEVEMENTS.each do |definition|
      vid = definition[:vendor_identifier]
      if (existing = ach_by_vendor[vid])
        ach_id = existing['id']
        existing_locales = client.list_achievement_localizations(achievement_id: ach_id)
                                 .map { |l| l.dig('attributes', 'locale') }.compact
        missing = definition[:localizations].reject { |loc| existing_locales.include?(loc[:locale]) }
        if missing.empty?
          UI.message("  ↺ #{vid} already exists (id #{ach_id}) — skipping")
        else
          UI.message("  ↺ #{vid} already exists (id #{ach_id}) — adding #{missing.size} missing localization(s)")
          missing.each do |loc|
            UI.message("    ＋ Localization #{loc[:locale]}")
            client.create_achievement_localization(achievement_id: ach_id, definition: loc)
          end
        end
        achievement_summary << [vid, ach_id, 'kept']
        next
      end

      UI.message("  ＋ Creating achievement #{vid} (#{definition[:points]} pts)")
      created = client.create_achievement(detail_id: detail_id, definition: definition)
      ach_id = created.fetch('id')

      definition[:localizations].each do |loc|
        UI.message("    ＋ Localization #{loc[:locale]}")
        client.create_achievement_localization(achievement_id: ach_id, definition: loc)
      end

      achievement_summary << [vid, ach_id, 'created']
    end

    # MARK: - Summary

    UI.message("")
    UI.success("✅ Game Center setup complete")
    UI.message("   App: #{GameCenterConfig::BUNDLE_ID} (#{app_id})")
    UI.message("   Detail: #{detail_id}")
    UI.message("   Achievement points total: #{GameCenterConfig.total_achievement_points} / 1000")
    UI.message("")
    UI.message("Leaderboards:")
    leaderboard_summary.each do |vid, id, status|
      UI.message(format("   %-9s %-32s %s", "[#{status}]", vid, id))
    end
    UI.message("")
    UI.message("Achievements:")
    achievement_summary.each do |vid, id, status|
      UI.message(format("   %-9s %-32s %s", "[#{status}]", vid, id))
    end
    UI.message("")
    UI.important("Achievement images are NOT uploaded by this lane. Apple may require them before review;")
    UI.important("upload via App Store Connect → Game Center → <achievement> → Image, or extend this lane.")
  end

  desc "Clean build artifacts and temporary files"
  lane :clean do
    UI.message("🧹 Cleaning build artifacts...")

    # Clean Xcode build folder
    sh("xcodebuild clean -project '../#{XCODE_PROJECT}' -scheme '#{MAIN_SCHEME}'")

    # Remove fastlane build artifacts
    sh("rm -f ../*.ipa ../*.dSYM.zip")
    sh("rm -rf ./test_output ./report.xml")
    sh("rm -rf ./build_output")

    # Remove derived data if needed (optional, commented out by default)
    # sh("rm -rf ~/Library/Developer/Xcode/DerivedData/LeavesOfBlocks-*")

    UI.success("✨ Clean complete!")
  end

  desc "Test AI release notes generation (requires ANTHROPIC_API_KEY)"
  lane :test_ai do
    if AIHelper.available?
      UI.message("Testing AI helper module...")

      # Test changelog enhancement
      test_commits = [
        "feat: Add new game statistics dashboard",
        "fix: Resolve crash when placing L-shaped blocks near edge",
        "refactor: Improve block generation performance",
        "chore: Update CI configuration",
        "feat(ui): Add autumn leaf animation effects"
      ]

      UI.message("\n=== Testing Changelog Enhancement ===")
      result = AIHelper.enhance_changelog(commits: test_commits, new_version: "1.2.0")
      if result
        UI.success("Changelog result:")
        UI.message("  Added: #{result[:added].inspect}")
        UI.message("  Changed: #{result[:changed].inspect}")
        UI.message("  Fixed: #{result[:fixed].inspect}")
        UI.message("  Removed: #{result[:removed].inspect}")
      else
        UI.error("Changelog enhancement failed")
      end

      # Test prose generation
      sample_changelog = <<~CHANGELOG
        ### Added
        - New game statistics dashboard with session history
        - Autumn leaf animation effects during line clears

        ### Fixed
        - Crash when placing L-shaped blocks near grid edge
      CHANGELOG

      UI.message("\n=== Testing Prose Generation ===")
      prose = AIHelper.generate_prose(changelog_section: sample_changelog, version: "1.2.0")
      if prose
        UI.success("Generated prose (#{prose.length} chars):")
        UI.message(prose)
      else
        UI.error("Prose generation failed")
      end

      UI.success("\n✅ AI release notes test complete!")
    else
      UI.error("ANTHROPIC_API_KEY not set. Set it to test AI features:")
      UI.message("  export ANTHROPIC_API_KEY='your-key-here'")
      UI.message("  Or add to fastlane/.env file")
    end
  end

  after_all do |lane|
    # This block is called, only if the executed lane was successful
    macos_notification(message: "Fastlane finished '#{lane}' successfully! 🎉")
  end

  error do |lane, exception|
    # This block is called, only if the executed lane failed
    macos_notification(message: "Fastlane '#{lane}' failed with error: #{exception.message} ❌")
  end
end
