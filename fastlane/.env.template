# App Store Connect API Key Configuration
# Copy this file to .env and fill in your actual values:
#   cp fastlane/.env.template fastlane/.env
# 
# To get these values:
# 1. Go to App Store Connect → Users and Access → Keys tab
# 2. Create a new API key with "App Manager" role
# 3. Download the .p8 file and note the Key ID and Issuer ID

# Your App Store Connect API Key ID (e.g., "D383SF739")
LOCAL_APP_STORE_CONNECT_API_KEY_ID=your_key_id_here

# Your App Store Connect Issuer ID (UUID format, found at top of Keys page)
LOCAL_APP_STORE_CONNECT_ISSUER_ID=your_issuer_id_here

# Path to your downloaded .p8 API key file.
# IMPORTANT: fastlane runs with its working directory set to fastlane/, so
# relative paths resolve against fastlane/, not the project root. Use an
# absolute path (recommended) or `../AuthKey.p8` if the file lives in the
# project root.
LOCAL_APP_STORE_CONNECT_API_KEY_PATH=/absolute/path/to/AuthKey.p8

# Optional: Team ID if you're on multiple teams
# LOCAL_FASTLANE_TEAM_ID=your_team_id_here

# Optional: App identifier (bundle ID)
# LOCAL_FASTLANE_APP_IDENTIFIER=timothy.veil.LeavesOfBlocks

# Developer contact details — used in App Store Connect review submissions
# Required for `bundle exec fastlane ios deploy` and related submission lanes
LOCAL_FASTLANE_DEVELOPER_FIRST_NAME=your_first_name
LOCAL_FASTLANE_DEVELOPER_LAST_NAME=your_last_name
LOCAL_FASTLANE_DEVELOPER_PHONE=+1 555 555 5555
LOCAL_FASTLANE_DEVELOPER_EMAIL=you@example.com

# Anthropic API Key for AI-powered release notes generation (optional)
# Get your API key at: https://console.anthropic.com/
# If not set, the system falls back to template-based generation
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Fastlane/Xcode build settings timeout (in seconds)
# xcodebuild -showBuildSettings can be slow on Xcode 26+; default is 3s which is too short
FASTLANE_XCODEBUILD_SETTINGS_TIMEOUT=120