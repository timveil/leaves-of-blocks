# Fastlane Snapfile Configuration for Leaves of Blocks

# Import shared constants. `require_relative` fails under fastlane's eval-based
# loader on Ruby 3.x+, so resolve the fastlane dir from Dir.pwd and use
# `require` (idempotent across fastlane's repeated config evaluations).
fastlane_dir = ['fastlane', '.']
  .map { |d| File.expand_path(d, Dir.pwd) }
  .find { |d| File.exist?(File.join(d, 'Constants.rb')) }
require File.join(fastlane_dir, 'Constants')

# Devices for screenshot capture - use App Store Connect compatible devices
devices(SCREENSHOT_DEVICES)

# Pin iOS runtime version so xcodebuild's destination string matches the
# installed simulator OS exactly (fastlane otherwise emits the runtime label,
# e.g. "26.4", instead of the point version like "26.4.1").
ios_version(IOS_VERSION)

# Languages for localized screenshots
languages(SCREENSHOT_LANGUAGES)

# The name of the scheme which contains the UI Tests
scheme(MAIN_SCHEME)

# Where should the resulting screenshots be stored?
output_directory(SCREENSHOTS_PATH)

# Clear all previously generated screenshots before creating new ones
clear_previous_screenshots(true)

# Set the status bar to 9:41 AM, and show full battery and reception
override_status_bar(true)

# Launch arguments - enable screenshot mode to show demo content  
launch_arguments([
  "-ui-testing -screenshot-mode"
])

# Skip HTML report generation if it's causing issues
skip_open_summary(false)

# For more information about all available options run
# fastlane action snapshot
