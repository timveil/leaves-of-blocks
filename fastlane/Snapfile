# Fastlane Snapfile Configuration for Leaves of Blocks

# Devices for screenshot capture
devices([
  "iPhone 16 Pro Max"
])

# Specify destination to avoid architecture ambiguity
destination("platform=iOS Simulator,name=iPhone 16 Pro Max,arch=arm64")

# Languages for localized screenshots
languages([
  "en-US"
])

# The name of the scheme which contains the UI Tests
scheme("LeavesOfBlocks")

# Where should the resulting screenshots be stored?
output_directory("./fastlane/screenshots")

# Clear all previously generated screenshots before creating new ones
clear_previous_screenshots(true)

# Set the status bar to 9:41 AM, and show full battery and reception
override_status_bar(true)

# Launch arguments - enable screenshot mode to show demo content
launch_arguments([
  "-ui-testing",
  "-screenshot-mode"
])

