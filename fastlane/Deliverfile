# Deliverfile
# Configuration for Fastlane Deliver
# For more information about available options, run `fastlane deliver --help`

# Import shared constants. `require_relative` fails under fastlane's eval-based
# loader on Ruby 3.x+, so resolve the fastlane dir from Dir.pwd and use
# `require` (idempotent across fastlane's repeated config evaluations).
fastlane_dir = ['fastlane', '.']
  .map { |d| File.expand_path(d, Dir.pwd) }
  .find { |d| File.exist?(File.join(d, 'Constants.rb')) }
require File.join(fastlane_dir, 'Constants')

# App identifier
app_identifier(APP_IDENTIFIER)

# App Store metadata configuration
metadata_path(METADATA_PATH)

# Screenshots configuration
screenshots_path(SCREENSHOTS_PATH)

# App Store release options
submit_for_review(false)  # Set to true to automatically submit for review
# Release on approval rather than waiting for a manual push. The phased
# rollout below then begins immediately, spreading the update over 7 days with
# the pause control still available -- so the safety net is the rollout itself
# rather than a human remembering to press a button.
automatic_release(true)
force(true)              # Skip HTML preview and upload directly

# Submission information (can be overridden in Fastfile)
submission_information(SUBMISSION_INFO)

# Price and availability
# Note: price_tier is deprecated - pricing is now managed in App Store Connect

# Reject if binary already exists
reject_if_possible(true)

# Phased release. Apple rolls an approved update out to auto-updating users
# over 7 days (1/2/5/10/20/50/100%) instead of all at once; users who seek the
# update manually still get it immediately. This is the project's only rollout
# safety net — there is no crash reporting beyond Xcode Organizer (by design:
# no third-party SDKs) — so a regression can be caught and the rollout paused
# from App Store Connect before it reaches the whole installed base.
phased_release(true)

# Reset ratings when new version is released
reset_ratings(false)

# Age rating answers, including the social-media questions App Store Connect
# added for September 2026. Keeping them here rather than only in the web UI
# means a submission cannot go out with stale answers, and a change to them
# shows up in review like any other.
app_rating_config_path("./fastlane/metadata/app_rating_config.json")

# App review information
app_review_information(app_review_info)

# Skip binary upload (we'll handle this separately)
skip_binary_upload(false)

# Skip screenshots upload if they haven't changed
skip_screenshots(true)

# Include metadata upload (release notes are auto-generated from CHANGELOG.md)
skip_metadata(false)

# Overwrite screenshots
overwrite_screenshots(true)

# Run precheck before upload
run_precheck_before_submit(true)

# Precheck configuration
precheck_include_in_app_purchases(false)