# Deliverfile
# Configuration for Fastlane Deliver
# For more information about available options, run `fastlane deliver --help`

# App identifier
app_identifier("timothy.veil.LeavesOfBlocks")

# Username for App Store Connect
# Uncomment and set your Apple ID for App Store Connect operations
# username("your.email@example.com")

# App Store metadata configuration
metadata_path("./fastlane/metadata")

# Screenshots configuration
screenshots_path("./fastlane/screenshots")

# App Store release options
submit_for_review(false)  # Set to true to automatically submit for review
automatic_release(false)  # Set to true to automatically release after approval
force(true)              # Skip HTML preview and upload directly

# Submission information (can be overridden in Fastfile)
submission_information({
  add_id_info_limits_tracking: true,
  add_id_info_serves_ads: false,
  add_id_info_tracks_action: false,
  add_id_info_tracks_install: false,
  add_id_info_uses_idfa: false,
  content_rights_has_rights: true,
  content_rights_contains_third_party_content: false,
  export_compliance_platform: 'ios',
  export_compliance_compliance_required: false,
  export_compliance_encryption_updated: false,
  export_compliance_app_type: nil,
  export_compliance_uses_encryption: false,
  export_compliance_is_exempt: false,
  export_compliance_contains_third_party_cryptography: false,
  export_compliance_contains_proprietary_cryptography: false,
  export_compliance_available_on_french_store: false
})

# Price and availability
# Note: price_tier is deprecated - pricing is now managed in App Store Connect

# Reject if binary already exists
reject_if_possible(true)

# Phased release
phased_release(false)

# Reset ratings when new version is released
reset_ratings(false)

# App review information
app_review_information({
  first_name: "Tim",
  last_name: "Veil",
  phone_number: "+1 678 296 7960",  # Replace with your phone number
  email_address: "timveil@mac.com",  # Replace with your email
  demo_user: "",
  demo_password: "",
  notes: "Leaves of Blocks is a Whitman-inspired block puzzle game. The app is completely offline with no network requests, no ads, no tracking, and no in-app purchases. All features are available immediately upon download. The game includes comprehensive statistics tracking and game history stored locally using Core Data."
})

# Skip binary upload (we'll handle this separately)
skip_binary_upload(false)

# Skip screenshots upload if they haven't changed
skip_screenshots(true)

# Skip metadata upload if it hasn't changed  
skip_metadata(false)

# Overwrite screenshots
overwrite_screenshots(true)

# Run precheck before upload
run_precheck_before_submit(true)

# Precheck configuration
precheck_include_in_app_purchases(false)