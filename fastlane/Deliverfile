# Deliverfile
# Configuration for Fastlane Deliver
# For more information about available options, run `fastlane deliver --help`

# Import shared constants relative to this file
require_relative 'Constants'

# App identifier
app_identifier(APP_IDENTIFIER)

# App Store metadata configuration
metadata_path(METADATA_PATH)

# Screenshots configuration
screenshots_path(SCREENSHOTS_PATH)

# App Store release options
submit_for_review(false)  # Set to true to automatically submit for review
automatic_release(false)  # Set to true to automatically release after approval
force(true)              # Skip HTML preview and upload directly

# Submission information (can be overridden in Fastfile)
submission_information(SUBMISSION_INFO)

# Price and availability
# Note: price_tier is deprecated - pricing is now managed in App Store Connect

# Reject if binary already exists
reject_if_possible(true)

# Phased release
phased_release(false)

# Reset ratings when new version is released
reset_ratings(false)

# App review information
app_review_information(app_review_info)

# Skip binary upload (we'll handle this separately)
skip_binary_upload(false)

# Skip screenshots upload if they haven't changed
skip_screenshots(true)

# Include metadata upload (release notes are auto-generated from CHANGELOG.md)
skip_metadata(false)

# Overwrite screenshots
overwrite_screenshots(true)

# Run precheck before upload
run_precheck_before_submit(true)

# Precheck configuration
precheck_include_in_app_purchases(false)