// MARK: - How to Play
"how_to_play_quote" = "Para mí cada hora de luz y oscuridad es un milagro, Cada pulgada cúbica de espacio es un milagro,";
"how_to_play_author" = "Walt Whitman";
"how_to_play_title" = "Milagros";
"how_to_play_year" = "1856";

"the_grid" = "El Campo de Juego";
"the_grid_description" = "Tu tablero de juego es una cuadrícula de 8×8 con 64 espacios. Tu objetivo es completar filas horizontales o columnas verticales para eliminarlas y ganar puntos. La cuadrícula comienza con algunos bloques aleatorios ya colocados para crear desafíos interesantes.";

"drag_drop" = "Cómo Jugar";
"drag_drop_description" = "Verás hasta 3 formas de bloques en la parte inferior de la pantalla. Simplemente arrastra cualquier forma a la cuadrícula donde quepa completamente. Los bloques no pueden superponerse a piezas existentes ni extenderse más allá de los bordes de la cuadrícula. Cuando uses los 3 bloques, recibirás 3 nuevos automáticamente.";

"clear_lines" = "Completar Líneas";
"clear_lines_description" = "Cuando completas una fila horizontal o columna vertical, ¡desaparece y ganas puntos! Elimina múltiples líneas a la vez para obtener puntos de bonificación. Cuantas más líneas elimines simultáneamente, mayor será tu bonificación de combo.";

"game_over_rules" = "Fin del Juego";
"game_over_description" = "El juego termina cuando ninguno de tus 3 bloques actuales puede caber en ningún lugar de la cuadrícula. No te preocupes - el juego incluye funciones inteligentes para ayudar a prevenir esto ajustando los tipos de bloques que recibes según la situación de tu cuadrícula.";

"advanced_features" = "Funciones Avanzadas";
"advanced_features_description" = "Leaves of Blocks incluye sistemas sofisticados que se adaptan a tu estilo de juego y te ayudan a mejorar con el tiempo.";

"efficiency_system" = "Seguimiento de Rendimiento";
"efficiency_system_description" = "El juego rastrea qué tan eficientemente usas el espacio de la cuadrícula y proporciona calificaciones de A+ a D. Mayor eficiencia proviene de mantener la cuadrícula organizada y minimizar el espacio desperdiciado.";

"strategic_grading" = "Juego Estratégico";
"strategic_grading_description" = "Tus habilidades estratégicas se califican de Principiante a Maestro según qué tan bien preparas las eliminaciones de líneas y planificas con anticipación. Busca oportunidades para eliminar múltiples líneas con una sola colocación de bloque.";

"adaptive_difficulty" = "Generación Inteligente de Bloques";
"adaptive_difficulty_description" = "El juego analiza tu cuadrícula y ajusta los bloques que recibes para mantener el desafío mientras previene situaciones imposibles. Cuando estás en dificultades, proporciona formas más útiles automáticamente.";

"pro_tips" = "Consejos Pro";

