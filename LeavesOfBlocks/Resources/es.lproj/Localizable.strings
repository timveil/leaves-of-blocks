"tip_plan_ahead" = "Considera los tres bloques disponibles antes de colocar cualquiera";
"tip_corners_edges" = "Usa las esquinas y bordes estratégicamente cuando la cuadrícula se llene";
"tip_save_small_blocks" = "Guarda los bloques pequeños para espacios reducidos y movimientos finales";
"tip_efficiency_matters" = "Tu calificación de eficiencia mejora con juego organizado y estratégico";

