"the_grid" = "The Playing Field";
"the_grid_description" = "Your game board is an 8×8 grid with 64 spaces. Your goal is to fill complete horizontal rows or vertical columns to clear them and earn points. The grid starts with some random blocks already placed to create interesting challenges.";

"drag_drop" = "How to Play";
"drag_drop_description" = "You'll see up to 3 block shapes at the bottom of the screen. Simply drag any shape onto the grid where it fits completely. Blocks cannot overlap existing pieces or extend beyond the grid edges. When you use all 3 blocks, you'll get 3 new ones automatically.";

"clear_lines" = "Clearing Lines";
"clear_lines_description" = "When you completely fill a horizontal row or vertical column, it disappears and you earn points! Clear multiple lines at once for bonus points. The more lines you clear simultaneously, the bigger your combo bonus.";

"game_over_rules" = "Game Over";
"game_over_description" = "The game ends when none of your current 3 blocks can fit anywhere on the grid. Don't worry - the game includes smart features to help prevent this by adjusting the types of blocks you receive based on your grid situation.";

"advanced_features" = "Advanced Features";
"advanced_features_description" = "Leaves of Blocks includes sophisticated systems that adapt to your play style and help you improve over time.";

"efficiency_system" = "Performance Tracking";
"efficiency_system_description" = "The game tracks how efficiently you use the grid space and provides grades from A+ to D. Higher efficiency comes from keeping the grid organized and minimizing wasted space.";

"strategic_grading" = "Strategic Play";
"strategic_grading_description" = "Your strategic skills are rated from Beginner to Master based on how well you set up line clears and plan ahead. Look for opportunities to clear multiple lines with a single block placement.";

"adaptive_difficulty" = "Smart Block Generation";
"adaptive_difficulty_description" = "The game analyzes your grid and adjusts the blocks you receive to maintain challenge while preventing impossible situations. When you're struggling, it provides more helpful shapes automatically.";

"pro_tips" = "Pro Tips";

