    "game_center_enable_description" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn aktiv, werden dein Endstand und erreichte Erfolge an Apples Game Center gesendet. Standardmäßig aus — deine Daten bleiben auf diesem Gerät, bis du zustimmst. Keine Werbung, kein Tracking durch Dritte, kein Datenverkauf."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When on, your final score and earned achievements are sent to Apple's Game Center. Off by default — your data stays on this device until you opt in. No ads, no third-party tracking, no data sold."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando está activado, tu puntuación final y logros se envían a Game Center de Apple. Desactivado por defecto — tus datos permanecen en este dispositivo hasta que aceptes. Sin anuncios, sin rastreo de terceros, sin venta de datos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une fois activé, ton score final et tes succès sont envoyés à Game Center d'Apple. Désactivé par défaut : tes données restent sur cet appareil tant que tu n'as rien activé. Aucune publicité, aucun pistage tiers, aucune revente de données."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オンにすると、最終スコアと獲得した実績が Apple の Game Center に送信されます。初期設定はオフで、オンにするまでデータはこの端末に留まります。広告なし、第三者による追跡なし、データの販売なし。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als dit aanstaat, worden je eindscore en behaalde prestaties naar Game Center van Apple gestuurd. Staat standaard uit: je gegevens blijven op dit apparaat totdat je ermee instemt. Geen advertenties, geen tracking door derden, geen verkoop van gegevens."
          }
        }
      }
    },
    "game_over" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
