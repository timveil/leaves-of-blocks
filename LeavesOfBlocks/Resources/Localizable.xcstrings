    "shape_area_desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fläche räumen ist der stärkste Block. Dieser lila Block räumt ein 3×3-Feld rund um die Stelle, an der du ihn setzt. Setz ihn klug ein, dann wirkt er am meisten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Area Clear is the ultimate power block. This purple block clears a 3×3 area around wherever you place it. Use wisely for maximum impact."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eliminar Área es el bloque de poder definitivo. Este bloque morado elimina un área de 3×3 alrededor de donde lo coloques. Úsalo sabiamente para máximo impacto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zone est le bloc le plus puissant. Ce bloc violet efface une zone de 3×3 autour de l'endroit où tu le poses. À garder pour le bon moment."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "エリア消去は最強のブロックです。この紫のブロックは、置いた場所を中心に3×3の範囲を消します。ここぞという場面で使いましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "영역 제거는 가장 강력한 블록이에요. 이 보라색 블록은 놓은 자리를 중심으로 3×3 영역을 없애요. 꼭 필요한 순간에 쓰세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vlak wissen is het krachtigste blok. Dit paarse blok wist een gebied van 3×3 rond de plek waar je het neerlegt. Bewaar het voor het juiste moment."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limpar Área é o bloco mais poderoso de todos. Este bloco roxo limpa uma área de 3×3 ao redor do ponto onde você o coloca. Use com sabedoria para causar o maior impacto."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "区域消除是威力最强的方块。这个紫色方块会清掉放置处周围 3×3 的范围。善加利用，效果最大。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "區域消除是威力最強的方塊。這個紫色方塊會清掉放置處周圍 3×3 的範圍。善加運用，效果最大。"
          }
        }
      }
    },
