    "clear_history_warning" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Damit werden alle gespeicherten Spiele und Statistiken dauerhaft gelöscht. Das lässt sich nicht rückgängig machen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This will permanently delete all your saved games and statistics. This action cannot be undone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto eliminará permanentemente todas tus partidas guardadas y estadísticas. Esta acción no se puede deshacer."
          }
        }
      }
    },
    "clear_lines" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reihen räumen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clearing Lines"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Completar Líneas"
          }
        }
      }
    },
    "clear_lines_description" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sobald du eine Reihe oder Spalte vollständig füllst, verschwindet sie und bringt dir Punkte. Räume mehrere auf einmal für Bonuspunkte: je mehr gleichzeitig, desto größer der Combo-Bonus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When you completely fill a horizontal row or vertical column, it disappears and you earn points! Clear multiple lines at once for bonus points. The more lines you clear simultaneously, the bigger your combo bonus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando completas una fila horizontal o columna vertical, ¡desaparece y ganas puntos! Elimina múltiples líneas a la vez para obtener puntos de bonificación. Cuantas más líneas elimines simultáneamente, mayor será tu bonificación de combo."
          }
        }
      }
    },
