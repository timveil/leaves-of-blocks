    "how_to_play_quote" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To me every hour of the light and dark is a miracle, Every cubic inch of space is a miracle,"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para mí cada hora de luz y oscuridad es un milagro, Cada pulgada cúbica de espacio es un milagro,"
          }
        }
      }
    },
