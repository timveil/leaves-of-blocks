    "adaptive_difficulty_description" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Spiel analysiert dein Feld und passt die Blöcke an, die du bekommst: fordernd, aber nie ausweglos. Wenn es eng wird, kommen automatisch hilfreichere Formen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The game analyzes your grid and adjusts the blocks you receive to maintain challenge while preventing impossible situations. When you're struggling, it provides more helpful shapes automatically."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El juego analiza tu cuadrícula y ajusta los bloques que recibes para mantener el desafío mientras previene situaciones imposibles. Cuando estás en dificultades, proporciona formas más útiles automáticamente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le jeu analyse ta grille et ajuste les blocs qu'il te propose : de quoi rester stimulant sans jamais te bloquer. Quand ça se complique, les formes utiles arrivent d'elles-mêmes."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "盤面を分析して、手ごたえを保ちながら詰みを防ぐようにブロックを調整します。苦しい場面では、置きやすい形が自動的に増えます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het spel bekijkt je speelveld en past de blokken aan die je krijgt: uitdagend, maar nooit uitzichtloos. Wordt het krap, dan komen er vanzelf handiger vormen."
          }
        }
      }
    },
