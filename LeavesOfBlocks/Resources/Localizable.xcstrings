    "assist_view_board" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Feld ansehen: zeigt nach Spielende das letzte Feld, so wie es ausgegangen ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "View Board: when the game ends, reveal the final board to see how it finished."
