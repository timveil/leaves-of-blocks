    "tip_keep_organized" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte dein Feld aufgeräumt — vermeide verstreute Lücken"
          }
        },
        "en" : {
          "stringUnit" : {
