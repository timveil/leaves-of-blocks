    "how_to_play_quote" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To me every hour of the light and dark is a miracle, Every cubic inch of space is a miracle,"
          }
        },
        "en" : {
