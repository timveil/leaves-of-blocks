        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "와일드는 숙련된 플레이어를 위한 난이도예요. 크고 복잡한 블록이 늘어나 전략적인 판단이 필요해요"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wild is voor ervaren spelers: reken op meer grote, ingewikkelde blokken die om strategie vragen"
