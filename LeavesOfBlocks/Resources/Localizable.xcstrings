    "technical_description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Built with SwiftUI for iOS 18.5+. No ads, no tracking, no data collection. Play offline, scores stay private."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Construido con SwiftUI para iOS 18.5+. Sin anuncios, sin rastreo, sin recolección de datos. Juega sin conexión, las puntuaciones permanecen privadas."
          }
        }
