    "clear_lines_description" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sobald du eine Reihe oder Spalte vollständig füllst, verschwindet sie und bringt dir Punkte. Räume mehrere auf einmal für Bonuspunkte: je mehr gleichzeitig, desto größer der Combo-Bonus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When you completely fill a horizontal row or vertical column, it disappears and you earn points! Clear multiple lines at once for bonus points. The more lines you clear simultaneously, the bigger your combo bonus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando completas una fila horizontal o columna vertical, ¡desaparece y ganas puntos! Elimina múltiples líneas a la vez para obtener puntos de bonificación. Cuantas más líneas elimines simultáneamente, mayor será tu bonificación de combo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dès qu'une ligne ou une colonne est entièrement remplie, elle disparaît et te rapporte des points. Efface-en plusieurs d'un coup pour un bonus : plus il y en a en même temps, plus le combo est généreux."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "横の行または縦の列をすべて埋めると、そのラインが消えてスコアになります。複数のラインを同時に消すとボーナス点が入り、同時に消すほどコンボボーナスが大きくなります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "가로줄이나 세로줄을 빈틈없이 채우면 그 줄이 사라지면서 점수가 들어와요. 여러 줄을 한 번에 없애면 보너스가 붙고, 동시에 없앤 줄이 많을수록 콤보 보너스가 커져요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zodra je een rij of kolom helemaal vult, verdwijnt die en levert hij punten op. Wis er meerdere tegelijk voor bonuspunten: hoe meer tegelijk, hoe groter de combobonus."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando você preenche completamente uma linha horizontal ou uma coluna vertical, ela desaparece e você ganha pontos! Elimine várias linhas de uma vez para ganhar pontos de bônus. Quanto mais linhas você eliminar ao mesmo tempo, maior o seu bônus de combo."
          }
        }
      }
    },
