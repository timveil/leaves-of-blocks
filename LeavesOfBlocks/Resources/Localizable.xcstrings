    "the_grid_description" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Spielfeld ist ein 8×8-Raster mit 64 Plätzen. Ziel ist es, ganze waagerechte Reihen oder senkrechte Spalten zu füllen, um sie zu räumen und Punkte zu sammeln. Zu Beginn liegen schon ein paar Blöcke auf dem Feld, damit es gleich interessant wird."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your game board is an 8×8 grid with 64 spaces. Your goal is to fill complete horizontal rows or vertical columns to clear them and earn points. The grid starts with some random blocks already placed to create interesting challenges."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu tablero de juego es una cuadrícula de 8×8 con 64 espacios. Tu objetivo es completar filas horizontales o columnas verticales para eliminarlas y ganar puntos. La cuadrícula comienza con algunos bloques aleatorios ya colocados para crear desafíos interesantes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta grille compte 64 cases, en 8×8. L'objectif : remplir des lignes horizontales ou des colonnes verticales entières pour les effacer et marquer des points. Quelques blocs sont déjà posés au départ, histoire de rendre les choses intéressantes tout de suite."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "盤面は64マスの8×8グリッドです。横の行や縦の列をすべて埋めると消えてポイントになります。最初からいくつかブロックが置かれていて、序盤から考えどころがあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "보드는 64칸으로 이뤄진 8×8 격자예요. 가로줄이나 세로줄을 가득 채우면 그 줄이 사라지면서 점수가 돼요. 시작할 때 블록 몇 개가 이미 놓여 있어 처음부터 생각할 거리가 있어요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je speelveld is een raster van 8×8 met 64 vakjes. Het doel: hele horizontale rijen of verticale kolommen vullen om ze te wissen en punten te scoren. Er liggen al een paar blokken klaar bij de start, zodat het meteen interessant is."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu tabuleiro é uma grade de 8×8 com 64 espaços. Seu objetivo é preencher linhas horizontais ou colunas verticais completas para eliminá-las e ganhar pontos. A grade começa com alguns blocos já colocados ao acaso, para criar desafios interessantes."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的棋盘是 8×8 的方格，共 64 格。目标是填满完整的横行或竖列，把它们消除并得分。方格一开始就会随机放上一些方块，让局面更有看头。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的棋盤是 8×8 的方格，共 64 格。目標是填滿完整的橫列或直欄，把它們消除並得分。方格一開始就會隨機放上一些方塊，讓局面更有看頭。"
          }
        }
      }
    },
