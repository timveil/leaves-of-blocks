    "drag_drop" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "So wird gespielt"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How to Play"
          }
        },
        "es" : {
          "stringUnit" : {
