    "technical_description" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit SwiftUI für iOS 18.0+ entwickelt. Keine Werbung. Kein Tracking durch Dritte. Kein Datenverkauf. Standardmäßig offline — Apple Game Center für Bestenlisten und Erfolge ist optional."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Built with SwiftUI for iOS 18.0+. No ads. No third-party tracking. No data sold. Play offline by default — opt in to Apple Game Center for leaderboards and achievements."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Construido con SwiftUI para iOS 18.0+. Sin anuncios. Sin rastreo de terceros. Sin venta de datos. Juega sin conexión por defecto — actívalo en Game Center para tablas de clasificación y logros."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SwiftUI で開発、iOS 18.0 以降に対応。広告なし。第三者による追跡なし。データの販売なし。標準ではオフラインでプレイでき、Apple Game Center のリーダーボードと実績は任意で利用できます。"
          }
        }
      }
    },
