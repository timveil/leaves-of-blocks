    "shape_horizontal_desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reihe räumen ist ein starker roter Block, der beim Setzen sofort eine ganze waagerechte Reihe räumt. Ideal, um festgefahrene Stellen aufzubrechen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Row Clear is a powerful red block that instantly clears an entire horizontal row when placed. Great for breaking through tight spots."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eliminar Fila es un poderoso bloque rojo que elimina instantáneamente toda una fila horizontal al colocarlo. Ideal para superar situaciones difíciles."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ligne est un puissant bloc rouge qui efface toute une ligne horizontale dès qu'il est posé. Parfait pour débloquer une grille encombrée."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "行消去は、置くと横一行をまるごと消す強力な赤いブロックです。詰まった盤面を切り開くのに向いています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "행 제거는 놓는 순간 가로 한 줄을 통째로 없애는 강력한 빨간 블록이에요. 꽉 막힌 보드를 뚫는 데 좋아요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rij wissen is een krachtig rood blok dat bij plaatsing meteen een hele horizontale rij wist. Ideaal om een vastgelopen speelveld open te breken."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limpar Linha é um poderoso bloco vermelho que elimina na hora uma linha horizontal inteira ao ser colocado. Ótimo para abrir caminho em espaços apertados."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "横行消除是威力强大的红色方块，放下后会立刻清掉一整条横行。要打通拥挤的地方特别好用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "橫列消除是威力強大的紅色方塊，放下後會立刻清掉一整條橫列。要打通擁擠的地方特別好用。"
          }
        }
      }
    },
