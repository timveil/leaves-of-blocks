    "the_grid" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Spielfeld"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
