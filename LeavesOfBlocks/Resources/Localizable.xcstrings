    "difficulty_easy_desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sanft ist ideal für den Einstieg — mehr kleine, gut platzierbare Blöcke"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gentle mode is perfect for beginners — more small, manageable blocks that are easier to place"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El modo Gentil es perfecto para principiantes — más bloques pequeños y manejables que son más fáciles de colocar"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "やさしいは初めての方に最適です。小さくて置きやすいブロックが多く出ます"
          }
        }
      }
    },
    "difficulty_gentle" : {
      "extractionState" : "manual",
