          }
        }
      }
    },
    "efficiency_system" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leistungsauswertung"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Performance Tracking"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seguimiento de Rendimiento"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "パフォーマンス記録"
          }
        }
      }
    },
    "efficiency_system_description" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Spiel verfolgt, wie effizient du den Platz auf dem Feld nutzt, und vergibt Noten von A+ bis D. Eine hohe Effizienz erreichst du, indem du das Feld aufgeräumt hältst und wenig Platz verschenkst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The game tracks how efficiently you use the grid space and provides grades from A+ to D. Higher efficiency comes from keeping the grid organized and minimizing wasted space."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El juego rastrea qué tan eficientemente usas el espacio de la cuadrícula y proporciona calificaciones de A+ a D. Mayor eficiencia proviene de mantener la cuadrícula organizada y minimizar el espacio desperdiciado."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "盤面のスペースをどれだけ効率よく使えているかを記録し、A+ から D までの評価を付けます。盤面を整理して無駄を減らすほど、効率は高くなります。"
          }
        }
      }
    },
    "final_score" : {
      "extractionState" : "manual",
