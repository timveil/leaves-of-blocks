    "strategic_grading_description" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein strategisches Können wird von Anfänger bis Meister bewertet — danach, wie gut du Reihen vorbereitest und vorausdenkst. Halte Ausschau nach Gelegenheiten, mit einem einzigen Block mehrere Reihen zu räumen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your strategic skills are rated from Beginner to Master based on how well you set up line clears and plan ahead. Look for opportunities to clear multiple lines with a single block placement."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus habilidades estratégicas se califican de Principiante a Maestro según qué tan bien preparas las eliminaciones de líneas y planificas con anticipación. Busca oportunidades para eliminar múltiples líneas con una sola colocación de bloque."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ton sens tactique est évalué de Débutant à Maître selon ta façon de préparer les lignes et d'anticiper. Cherche les coups qui effacent plusieurs lignes d'un seul bloc."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ラインを消す準備や先読みの上手さに応じて、初心者から達人まで評価されます。1手で複数のラインを消せる場面を探しましょう。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je strategisch inzicht krijgt een waardering van Beginner tot Meester, op basis van hoe goed je rijen voorbereidt en vooruitdenkt. Let op kansen om met één blok meerdere rijen tegelijk te wissen."
          }
        }
      }
    },
