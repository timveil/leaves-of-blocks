    "shape_area_clear" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fläche räumen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Area Clear"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eliminar Área"
          }
        }
      }
    },
    "shape_area_desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fläche räumen ist der stärkste Block. Dieser lila Block räumt ein 3×3-Feld rund um die Stelle, an der du ihn setzt. Setz ihn klug ein, dann wirkt er am meisten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Area Clear is the ultimate power block. This purple block clears a 3×3 area around wherever you place it. Use wisely for maximum impact."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eliminar Área es el bloque de poder definitivo. Este bloque morado elimina un área de 3×3 alrededor de donde lo coloques. Úsalo sabiamente para máximo impacto."
          }
        }
      }
    },
    "shape_column_clear" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spalte räumen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Column Clear"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eliminar Columna"
          }
        }
      }
    },
    "shape_horizontal_desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reihe räumen ist ein starker roter Block, der beim Setzen sofort eine ganze waagerechte Reihe räumt. Ideal, um festgefahrene Stellen aufzubrechen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Row Clear is a powerful red block that instantly clears an entire horizontal row when placed. Great for breaking through tight spots."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eliminar Fila es un poderoso bloque rojo que elimina instantáneamente toda una fila horizontal al colocarlo. Ideal para superar situaciones difíciles."
          }
        }
      }
    },
    "shape_normal_blocks" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Normale\nBlöcke"
