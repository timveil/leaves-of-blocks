    "about_game_description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A block puzzle game inspired by Walt Whitman's poetry and a love of ad-free gameplay. Place blocks thoughtfully, clear lines strategically, and find meaning in simple moments of focus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un juego de rompecabezas de bloques inspirado en la poesía de Walt Whitman y el amor por el juego sin anuncios. Coloca bloques con cuidado, elimina líneas estratégicamente y encuentra significado en simples momentos de concentración."
          }
        }
      }
    },
    "about_menu" : {
      "extractionState" : "manual",
      "localizations" : {
