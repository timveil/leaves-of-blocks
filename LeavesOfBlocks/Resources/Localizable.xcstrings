    "inspiration_quote" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Born from a love of block puzzles, frustration with ads, and inspiration from Walt Whitman's timeless poetry."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nacido del amor por los rompecabezas de bloques, la frustración con los anuncios y la inspiración de la poesía atemporal de Walt Whitman."
          }
        }
      }
    },
    "last_score_format" : {
      "extractionState" : "manual",
      "localizations" : {
