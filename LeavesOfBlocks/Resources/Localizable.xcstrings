    "drag_drop" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How to Play"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cómo Jugar"
          }
        }
      }
    },
    "drag_drop_description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You'll see up to 3 block shapes at the bottom of the screen. Simply drag any shape onto the grid where it fits completely. Blocks cannot overlap existing pieces or extend beyond the grid edges. When you use all 3 blocks, you'll get 3 new ones automatically."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verás hasta 3 formas de bloques en la parte inferior de la pantalla. Simplemente arrastra cualquier forma a la cuadrícula donde quepa completamente. Los bloques no pueden superponerse a piezas existentes ni extenderse más allá de los bordes de la cuadrícula. Cuando uses los 3 bloques, recibirás 3 nuevos automáticamente."
          }
        }
      }
    },
    "efficiency" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Efficiency"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eficiencia"
          }
        }
      }
    },
    "efficiency_system" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Performance Tracking"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seguimiento de Rendimiento"
          }
        }
      }
    },
    "efficiency_system_description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The game tracks how efficiently you use the grid space and provides grades from A+ to D. Higher efficiency comes from keeping the grid organized and minimizing wasted space."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El juego rastrea qué tan eficientemente usas el espacio de la cuadrícula y proporciona calificaciones de A+ a D. Mayor eficiencia proviene de mantener la cuadrícula organizada y minimizar el espacio desperdiciado."
          }
        }
      }
    },
    "final_score" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Final Score"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puntuación Final"
          }
        }
      }
    },
    "game_center_enable" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enable Game Center"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activar Game Center"
          }
        }
      }
    },
    "game_center_enable_description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When on, your final score and earned achievements are sent to Apple's Game Center. Off by default — your data stays on this device until you opt in. No ads, no third-party tracking, no data sold."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando está activado, tu puntuación final y logros se envían a Game Center de Apple. Desactivado por defecto — tus datos permanecen en este dispositivo hasta que aceptes. Sin anuncios, sin rastreo de terceros, sin venta de datos."
          }
        }
      }
    },
    "game_over" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Game Over"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fin del Juego"
          }
        }
      }
    },
    "game_over_description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The game ends when none of your current 3 blocks can fit anywhere on the grid. Don't worry - the game includes smart features to help prevent this by adjusting the types of blocks you receive based on your grid situation."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El juego termina cuando ninguno de tus 3 bloques actuales puede caber en ningún lugar de la cuadrícula. No te preocupes - el juego incluye funciones inteligentes para ayudar a prevenir esto ajustando los tipos de bloques que recibes según la situación de tu cuadrícula."
          }
        }
      }
    },
    "game_over_quote" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "That the powerful game has ended, and You could not contribute a block."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Que el poderoso juego ha terminado, y Tú no pudiste contribuir un bloque."
          }
        }
      }
