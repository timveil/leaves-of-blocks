    "assists_description" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für enge Situationen. Rückgängig und Tipp kannst du je einmal pro Spiel nutzen:"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Helpers for when you're in a tight spot. Undo and Hint can each be used once per game:"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayudas para cuando estás en un apuro. Deshacer y Pista se pueden usar una vez por partida cada una:"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour les moments difficiles. Annuler et Indice s'utilisent chacun une fois par partie :"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "苦しいときのための機能です。取り消しとヒントは1ゲームにつき1回ずつ使えます:"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "막혔을 때를 위한 기능이에요. 되돌리기와 힌트는 게임당 한 번씩 쓸 수 있어요:"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voor als het krap wordt. Ongedaan maken en Hint kun je elk één keer per spel gebruiken:"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auxílios para quando você estiver em apuros. Desfazer e Dica podem ser usados uma vez por partida:"
          }
        }
      }
    },
    "assist_undo" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rückgängig: nimmt deinen letzten gesetzten Block zurück."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Undo: take back your last block placement."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deshacer: recupera tu última colocación de bloque."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Annuler le coup : reprend le dernier bloc que tu as posé."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "取り消し: 直前に置いたブロックを戻します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "되돌리기: 마지막에 놓은 블록을 되돌려요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ongedaan maken: neemt je laatst geplaatste blok terug."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desfazer: volta atrás na sua última colocação de bloco."
          }
        }
      }
    },
    "assist_hint" : {
