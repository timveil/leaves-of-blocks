    "technical_description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Built with SwiftUI for iOS 18.5+. No ads. No third-party tracking. No data sold. Play offline by default — opt in to Apple Game Center for leaderboards and achievements."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Construido con SwiftUI para iOS 18.5+. Sin anuncios. Sin rastreo de terceros. Sin venta de datos. Juega sin conexión por defecto — actívalo en Game Center para tablas de clasificación y logros."
          }
        }
      }
    },
