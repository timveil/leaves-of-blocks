          }
        }
      }
    },
    "advanced_features_description" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leaves of Blocks bringt Systeme mit, die sich deinem Spielstil anpassen und dir helfen, mit der Zeit besser zu werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leaves of Blocks includes sophisticated systems that adapt to your play style and help you improve over time."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leaves of Blocks incluye sistemas sofisticados que se adaptan a tu estilo de juego y te ayudan a mejorar con el tiempo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leaves of Blocks には、プレイスタイルに合わせて上達を後押しする仕組みが備わっています。"
          }
        }
      }
    },
