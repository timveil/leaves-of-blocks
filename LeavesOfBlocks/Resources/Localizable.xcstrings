    "assists_description" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für enge Situationen. Rückgängig und Tipp kannst du je einmal pro Spiel nutzen:"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Helpers for when you're in a tight spot. Undo and Hint can each be used once per game:"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayudas para cuando estás en un apuro. Deshacer y Pista se pueden usar una vez por partida cada una:"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "苦しいときのための機能です。取り消しとヒントは1ゲームにつき1回ずつ使えます:"
          }
        }
      }
    },
    "assist_undo" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rückgängig: nimmt deinen letzten gesetzten Block zurück."
