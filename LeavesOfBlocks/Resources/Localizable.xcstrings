    "game_center_enable_description" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn aktiv, werden dein Endstand und erreichte Erfolge an Apples Game Center gesendet. Standardmäßig aus — deine Daten bleiben auf diesem Gerät, bis du zustimmst. Keine Werbung, kein Tracking durch Dritte, kein Datenverkauf."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When on, your final score and earned achievements are sent to Apple's Game Center. Off by default — your data stays on this device until you opt in. No ads, no third-party tracking, no data sold."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando está activado, tu puntuación final y logros se envían a Game Center de Apple. Desactivado por defecto — tus datos permanecen en este dispositivo hasta que aceptes. Sin anuncios, sin rastreo de terceros, sin venta de datos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une fois activé, ton score final et tes succès sont envoyés à Game Center d'Apple. Désactivé par défaut : tes données restent sur cet appareil tant que tu n'as rien activé. Aucune publicité, aucun pistage tiers, aucune revente de données."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オンにすると、最終スコアと獲得した実績が Apple の Game Center に送信されます。初期設定はオフで、オンにするまでデータはこの端末に留まります。広告なし、第三者による追跡なし、データの販売なし。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "켜면 최종 점수와 획득한 업적이 Apple Game Center로 전송돼요. 기본값은 꺼짐이며, 켜기 전까지 데이터는 이 기기에만 남아요. 광고 없음, 제3자 추적 없음, 데이터 판매 없음."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als dit aanstaat, worden je eindscore en behaalde prestaties naar Game Center van Apple gestuurd. Staat standaard uit: je gegevens blijven op dit apparaat totdat je ermee instemt. Geen advertenties, geen tracking door derden, geen verkoop van gegevens."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando ativado, sua pontuação final e as conquistas obtidas são enviadas ao Game Center da Apple. Desativado por padrão — seus dados ficam neste dispositivo até você escolher ativá-lo. Sem anúncios, sem rastreamento de terceiros, sem venda de dados."
          }
        }
      }
    },
    "game_over" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spiel vorbei"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Game Over"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fin del Juego"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Partie terminée"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ゲーム終了"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "게임 종료"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spel voorbij"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fim de Jogo"
          }
        }
      }
    },
    "game_over_description" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Spiel endet, wenn keiner deiner 3 Blöcke mehr irgendwo aufs Feld passt. Keine Sorge — das Spiel steuert dem entgegen, indem es die Art der Blöcke an deine Feldsituation anpasst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The game ends when none of your current 3 blocks can fit anywhere on the grid. Don't worry - the game includes smart features to help prevent this by adjusting the types of blocks you receive based on your grid situation."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El juego termina cuando ninguno de tus 3 bloques actuales puede caber en ningún lugar de la cuadrícula. No te preocupes - el juego incluye funciones inteligentes para ayudar a prevenir esto ajustando los tipos de bloques que recibes según la situación de tu cuadrícula."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La partie s'arrête quand aucun de tes 3 blocs ne peut plus être posé. Pas d'inquiétude : le jeu adapte les blocs proposés à l'état de ta grille pour retarder ce moment."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "手持ちの3つのブロックがどこにも置けなくなるとゲーム終了です。盤面の状況に応じて配られるブロックの種類が調整されるので、そう簡単には終わりません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "가진 블록 3개를 어디에도 놓을 수 없게 되면 게임이 끝나요. 걱정 마세요. 보드 상황에 맞춰 나오는 블록 종류가 조정되니까요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het spel eindigt als geen van je 3 blokken nog ergens past. Geen zorgen: het spel stemt de soort blokken af op je speelveld om dat uit te stellen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A partida termina quando nenhum dos seus 3 blocos atuais couber em lugar nenhum da grade. Não se preocupe — o jogo tem recursos inteligentes que ajudam a evitar isso, ajustando os tipos de bloco que você recebe conforme a situação da sua grade."
          }
        }
      }
    },
    "game_over_quote" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dass das mächtige Spiel geendet hat und Du keinen Block beitragen konntest."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "That the powerful game has ended, and You could not contribute a block."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Que el poderoso juego ha terminado, y Tú no pudiste contribuir un bloque."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Que le puissant jeu s'est achevé, et que Tu n'as pu y apporter un bloc."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "力強きゲームは終わり、あなたはひとつのブロックも捧げられなかった。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "힘찬 놀이가 끝났고, 그대는 블록 하나 보태지 못했으니."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dat het machtige spel geëindigd is, en Jij geen blok kon bijdragen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Que o poderoso jogo terminou, e Tu não pudeste contribuir com um bloco."
          }
        }
      }
    },
