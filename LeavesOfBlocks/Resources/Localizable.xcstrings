    "drag_drop" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "So wird gespielt"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How to Play"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cómo Jugar"
          }
        }
      }
    },
    "drag_drop_description" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unten am Bildschirm siehst du bis zu 3 Blockformen. Zieh eine davon auf das Feld, wo sie vollständig hineinpasst. Blöcke dürfen weder andere überlappen noch über den Rand hinausragen. Hast du alle 3 gesetzt, bekommst du automatisch 3 neue."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You'll see up to 3 block shapes at the bottom of the screen. Simply drag any shape onto the grid where it fits completely. Blocks cannot overlap existing pieces or extend beyond the grid edges. When you use all 3 blocks, you'll get 3 new ones automatically."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verás hasta 3 formas de bloques en la parte inferior de la pantalla. Simplemente arrastra cualquier forma a la cuadrícula donde quepa completamente. Los bloques no pueden superponerse a piezas existentes ni extenderse más allá de los bordes de la cuadrícula. Cuando uses los 3 bloques, recibirás 3 nuevos automáticamente."
          }
        }
      }
    },
    "efficiency" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Effizienz"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Efficiency"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eficiencia"
          }
        }
      }
    },
    "efficiency_system" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leistungsauswertung"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Performance Tracking"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seguimiento de Rendimiento"
          }
        }
      }
    },
    "efficiency_system_description" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Spiel verfolgt, wie effizient du den Platz auf dem Feld nutzt, und vergibt Noten von A+ bis D. Eine hohe Effizienz erreichst du, indem du das Feld aufgeräumt hältst und wenig Platz verschenkst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The game tracks how efficiently you use the grid space and provides grades from A+ to D. Higher efficiency comes from keeping the grid organized and minimizing wasted space."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El juego rastrea qué tan eficientemente usas el espacio de la cuadrícula y proporciona calificaciones de A+ a D. Mayor eficiencia proviene de mantener la cuadrícula organizada y minimizar el espacio desperdiciado."
          }
        }
      }
    },
    "final_score" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
