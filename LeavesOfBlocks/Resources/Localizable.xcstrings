    "advanced_features_description" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leaves of Blocks bringt Systeme mit, die sich deinem Spielstil anpassen und dir helfen, mit der Zeit besser zu werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leaves of Blocks includes sophisticated systems that adapt to your play style and help you improve over time."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leaves of Blocks incluye sistemas sofisticados que se adaptan a tu estilo de juego y te ayudan a mejorar con el tiempo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leaves of Blocks embarque des systèmes qui s'adaptent à ta façon de jouer et t'aident à progresser."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leaves of Blocks には、プレイスタイルに合わせて上達を後押しする仕組みが備わっています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leaves of Blocks에는 플레이 방식에 맞춰 적응하고 실력을 키우도록 돕는 기능이 들어 있어요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leaves of Blocks heeft systemen aan boord die zich aanpassen aan hoe jij speelt en je helpen beter te worden."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Leaves of Blocks tem sistemas sofisticados que se adaptam ao seu estilo de jogo e ajudam você a melhorar com o tempo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leaves of Blocks 拥有精巧的系统，会根据你的游玩风格进行调整，并帮助你逐步进步。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leaves of Blocks 具備精巧的系統，會配合你的遊玩風格調整，並幫助你逐步進步。"
          }
        }
      }
    },
