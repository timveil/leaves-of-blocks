    "drag_drop_description" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unten am Bildschirm siehst du bis zu 3 Blockformen. Zieh eine davon auf das Feld, wo sie vollständig hineinpasst. Blöcke dürfen weder andere überlappen noch über den Rand hinausragen. Hast du alle 3 gesetzt, bekommst du automatisch 3 neue."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You'll see up to 3 block shapes at the bottom of the screen. Simply drag any shape onto the grid where it fits completely. Blocks cannot overlap existing pieces or extend beyond the grid edges. When you use all 3 blocks, you'll get 3 new ones automatically."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verás hasta 3 formas de bloques en la parte inferior de la pantalla. Simplemente arrastra cualquier forma a la cuadrícula donde quepa completamente. Los bloques no pueden superponerse a piezas existentes ni extenderse más allá de los bordes de la cuadrícula. Cuando uses los 3 bloques, recibirás 3 nuevos automáticamente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jusqu'à 3 formes apparaissent en bas de l'écran. Fais glisser celle de ton choix sur la grille, là où elle tient entièrement. Les blocs ne peuvent ni se chevaucher ni dépasser du bord. Une fois les 3 posés, 3 nouveaux arrivent automatiquement."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "画面下部に最大3つのブロックが表示されます。すべて収まる場所にドラッグして配置してください。ブロックは既存のマスと重ねたり、盤面の外にはみ出したりできません。3つすべてを使うと、自動的に新しい3つが配られます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Onder in beeld zie je maximaal 3 blokvormen. Sleep er een naar het speelveld, op een plek waar hij helemaal past. Blokken mogen niet over elkaar heen liggen of buiten de rand vallen. Heb je alle 3 geplaatst, dan krijg je automatisch 3 nieuwe."
          }
        }
      }
    },
