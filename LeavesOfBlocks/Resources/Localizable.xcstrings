    "creator_description_suffix" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : ", Softwareentwickler und Vater, für den Spiele eine Auszeit sein sollten und kein Ärgernis."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : ", a software engineer and dad who believes games should provide a respite not rage."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : ", un ingeniero de software y padre que cree que los juegos deberían proporcionar un respiro, no rabia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : ", ingénieur logiciel et père de famille, convaincu qu'un jeu doit offrir une respiration et non une crise de nerfs."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "。ゲームは怒りではなく安らぎを与えるものだと考える、ソフトウェアエンジニアであり父親です。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : ", software-engineer en vader, die vindt dat een spel rust moet geven in plaats van ergernis."
          }
        }
      }
    },
