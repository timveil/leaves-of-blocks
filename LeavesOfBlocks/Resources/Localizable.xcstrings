        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spalte räumen ist ein starker blauer Block, der beim Setzen sofort eine ganze senkrechte Spalte räumt. Perfekt, um Platz zu schaffen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Column Clear is a powerful blue block that instantly clears an entire vertical column when placed. Perfect for creating space."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eliminar Columna es un poderoso bloque azul que elimina instantáneamente toda una columna vertical al colocarlo. Perfecto para crear espacio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Colonne est un puissant bloc bleu qui efface toute une colonne verticale dès qu'il est posé. Idéal pour faire de la place."
