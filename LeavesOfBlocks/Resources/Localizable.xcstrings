    "technical_description" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit SwiftUI für iOS 18.0+ entwickelt. Keine Werbung. Kein Tracking durch Dritte. Kein Datenverkauf. Standardmäßig offline — Apple Game Center für Bestenlisten und Erfolge ist optional."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Built with SwiftUI for iOS 18.0+. No ads. No third-party tracking. No data sold. Play offline by default — opt in to Apple Game Center for leaderboards and achievements."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Construido con SwiftUI para iOS 18.0+. Sin anuncios. Sin rastreo de terceros. Sin venta de datos. Juega sin conexión por defecto — actívalo en Game Center para tablas de clasificación y logros."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Développé avec SwiftUI pour iOS 18.0 et versions ultérieures. Aucune publicité. Aucun pistage tiers. Aucune revente de données. Hors ligne par défaut : Game Center d'Apple, pour les classements et les succès, reste facultatif."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SwiftUI で開発、iOS 18.0 以降に対応。広告なし。第三者による追跡なし。データの販売なし。標準ではオフラインでプレイでき、Apple Game Center のリーダーボードと実績は任意で利用できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SwiftUI로 개발했고 iOS 18.0 이상을 지원해요. 광고 없음. 제3자 추적 없음. 데이터 판매 없음. 기본은 오프라인 플레이이고, 순위표와 업적을 위한 Apple Game Center는 선택 사항이에요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gebouwd met SwiftUI voor iOS 18.0 en hoger. Geen advertenties. Geen tracking door derden. Geen verkoop van gegevens. Standaard offline te spelen: Game Center van Apple, voor ranglijsten en prestaties, is optioneel."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desenvolvido com SwiftUI para iOS 18.0 ou posterior. Sem anúncios. Sem rastreamento de terceiros. Sem venda de dados. Você joga offline por padrão — o Game Center da Apple, para classificações e conquistas, é opcional."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用 SwiftUI 开发，支持 iOS 18.0 及以上版本。没有广告。没有第三方跟踪。不出售数据。默认离线游玩——是否使用 Apple Game Center 的排行榜和成就，由你自己决定。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以 SwiftUI 開發，支援 iOS 18.0 以上。沒有廣告。沒有第三方追蹤。不販售資料。預設離線遊玩——是否使用 Apple Game Center 的排行榜與成就，由你自己決定。"
          }
        }
      }
    },
