            "state" : "translated",
            "value" : "저장된 게임과 통계가 모두 영구히 삭제돼요. 이 작업은 되돌릴 수 없어요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiermee worden al je opgeslagen spellen en statistieken definitief verwijderd. Dit kan niet ongedaan worden gemaakt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso vai apagar permanentemente todas as suas partidas salvas e estatísticas. Esta ação não pode ser desfeita."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这将永久删除你所有已保存的游戏和统计数据。此操作无法撤销。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這會永久刪除你所有已儲存的遊戲與統計資料。此動作無法復原。"
          }
        }
      }
    },
    "clear_lines" : {
      "extractionState" : "manual",
