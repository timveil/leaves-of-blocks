        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pista: resalta una jugada sugerida en el tablero."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indice : met en évidence un coup possible sur la grille."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ヒント: 盤面におすすめの一手を表示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "힌트: 보드에 놓을 만한 수를 표시해요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hint: laat een mogelijke zet op het speelveld zien."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dica: destaca uma jogada sugerida no tabuleiro."
          }
        },
