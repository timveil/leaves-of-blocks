    "dedication_text" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für Emma, Annie und Grace. Möge dieses Spiel eine kurze Ablenkung von den großen und kleinen Mühen des Lebens sein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For Emma, Annie and Grace. May this game serve as a momentary distraction from life's struggles, big and small."
