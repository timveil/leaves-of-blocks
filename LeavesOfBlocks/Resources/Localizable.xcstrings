    "efficiency_system_description" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Spiel verfolgt, wie effizient du den Platz auf dem Feld nutzt, und vergibt Noten von A+ bis D. Eine hohe Effizienz erreichst du, indem du das Feld aufgeräumt hältst und wenig Platz verschenkst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The game tracks how efficiently you use the grid space and provides grades from A+ to D. Higher efficiency comes from keeping the grid organized and minimizing wasted space."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El juego rastrea qué tan eficientemente usas el espacio de la cuadrícula y proporciona calificaciones de A+ a D. Mayor eficiencia proviene de mantener la cuadrícula organizada y minimizar el espacio desperdiciado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le jeu mesure l'efficacité avec laquelle tu occupes la grille et attribue une note de A+ à D. Plus la grille reste ordonnée et l'espace bien utilisé, plus la note monte."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "盤面のスペースをどれだけ効率よく使えているかを記録し、A+ から D までの評価を付けます。盤面を整理して無駄を減らすほど、効率は高くなります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "보드 공간을 얼마나 효율적으로 쓰는지 기록해 A+부터 D까지 등급을 매겨요. 보드를 정돈하고 빈 공간을 덜 낭비할수록 등급이 올라가요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het spel houdt bij hoe efficiënt je de ruimte op het speelveld gebruikt en geeft een cijfer van A+ tot D. Hoe overzichtelijker je speelveld en hoe minder ruimte je verspilt, hoe hoger het cijfer."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O jogo acompanha com que eficiência você usa o espaço da grade e dá notas de A+ a D. A eficiência sobe quando você mantém a grade organizada e desperdiça menos espaço."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "游戏会跟踪你利用方格空间的效率，并给出 A+ 到 D 的评级。把方格保持得井井有条、少浪费空间，效率就会提高。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "遊戲會追蹤你運用方格空間的效率，並給出 A+ 到 D 的評等。把方格維持得井然有序、少浪費空間，效率就會提高。"
          }
        }
      }
    },
