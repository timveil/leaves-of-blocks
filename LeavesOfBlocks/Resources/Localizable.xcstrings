          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "履歴、最高スコア、設定を含む「すべての」ゲームデータが完全に削除されます。この操作は取り消せません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기록, 최고 점수, 설정을 포함한 '모든' 게임 데이터가 영구히 삭제돼요. 이 작업은 되돌릴 수 없어요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiermee worden ALLE spelgegevens definitief verwijderd, inclusief geschiedenis, topscores en voorkeuren. Dit kan niet ongedaan worden gemaakt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
