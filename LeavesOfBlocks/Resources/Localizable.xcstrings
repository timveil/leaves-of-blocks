    "dedication_text" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für Emma, Annie und Grace. Möge dieses Spiel eine kurze Ablenkung von den großen und kleinen Mühen des Lebens sein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For Emma, Annie and Grace. May this game serve as a momentary distraction from life's struggles, big and small."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para Emma, Annie y Grace. Que este juego sirva como una distracción momentánea de las luchas de la vida, grandes y pequeñas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour Emma, Annie et Grace. Que ce jeu offre une parenthèse aux petites et grandes épreuves de la vie."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "エマ、アニー、グレースへ。このゲームが、大小さまざまな人生の苦労からのひとときの気晴らしになりますように。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "엠마, 애니, 그레이스에게. 이 게임이 크고 작은 삶의 무게에서 잠시 벗어나는 시간이 되기를."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voor Emma, Annie en Grace. Moge dit spel even afleiding bieden van de grote en kleine beslommeringen van het leven."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para Emma, Annie e Grace. Que este jogo sirva de distração momentânea das dificuldades da vida, grandes e pequenas."
          }
        }
      }
    },
