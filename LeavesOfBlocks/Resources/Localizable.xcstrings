    "shape_normal_desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Normale Blöcke sind deine Bausteine. Sie kommen in vielen Formen und Größen (je 1–9 Felder). Füll Reihen und Spalten, um sie zu räumen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Normal blocks are your main building pieces. They come in many shapes and sizes (1–9 squares each). Fill rows and columns to clear them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los bloques normales son tus piezas principales. Vienen en muchas formas y tamaños (1–9 cuadros cada uno). Llena filas y columnas para eliminarlas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les blocs classiques sont tes pièces de base. Ils existent en de nombreuses formes et tailles (de 1 à 9 cases). Remplis lignes et colonnes pour les effacer."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通常ブロックは基本となる駒です。形も大きさもさまざまで、1〜9マスあります。行や列を埋めて消しましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "일반 블록은 기본이 되는 조각이에요. 모양과 크기가 다양하고 한 블록에 1~9칸이에요. 행과 열을 채워 없애세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gewone blokken zijn je bouwstenen. Ze komen in allerlei vormen en maten (1 tot 9 vakjes). Vul rijen en kolommen om ze te wissen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os blocos comuns são suas peças principais. Vêm em muitos formatos e tamanhos, de 1 a 9 casas cada. Preencha linhas e colunas para eliminá-las."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "普通方块是你主要的建造材料，形状和大小各异，每个占 1 到 9 格。填满横行和竖列就能消除它们。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一般方塊是你主要的建構材料，形狀與大小各異，每個佔 1 到 9 格。填滿橫列與直欄就能消除它們。"
          }
        }
      }
    },
