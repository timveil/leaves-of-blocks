    "adaptive_difficulty" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Intelligente Blockauswahl"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Smart Block Generation"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Generación Inteligente de Bloques"
          }
        }
      }
    },
    "adaptive_difficulty_description" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Spiel analysiert dein Feld und passt die Blöcke an, die du bekommst: fordernd, aber nie ausweglos. Wenn es eng wird, kommen automatisch hilfreichere Formen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The game analyzes your grid and adjusts the blocks you receive to maintain challenge while preventing impossible situations. When you're struggling, it provides more helpful shapes automatically."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El juego analiza tu cuadrícula y ajusta los bloques que recibes para mantener el desafío mientras previene situaciones imposibles. Cuando estás en dificultades, proporciona formas más útiles automáticamente."
          }
        }
      }
    },
    "advanced_features" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erweiterte Funktionen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Advanced Features"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Funciones Avanzadas"
          }
        }
      }
    },
    "advanced_features_description" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leaves of Blocks bringt Systeme mit, die sich deinem Spielstil anpassen und dir helfen, mit der Zeit besser zu werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leaves of Blocks includes sophisticated systems that adapt to your play style and help you improve over time."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leaves of Blocks incluye sistemas sofisticados que se adaptan a tu estilo de juego y te ayudan a mejorar con el tiempo."
          }
        }
      }
    },
