    "difficulty_hard_desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wild ist für erfahrene Spieler — rechne mit mehr großen, komplexen Blöcken, die strategisches Denken verlangen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wild mode is for experienced players — expect more large, complex blocks that require strategic thinking"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El modo Salvaje es para jugadores experimentados — espera más bloques grandes y complejos que requieren pensamiento estratégico"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ワイルドは経験者向けです。大きく複雑なブロックが増え、戦略的な判断が求められます"
          }
        }
      }
    },
