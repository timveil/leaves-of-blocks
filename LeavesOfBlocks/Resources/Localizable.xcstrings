    "the_grid" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Spielfeld"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Playing Field"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El Campo de Juego"
          }
        },
        "ja" : {
