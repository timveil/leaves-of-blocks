    "difficulty_moderate_desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kühn bietet eine ausgewogene Herausforderung mit einer guten Mischung aus kleinen und großen Blöcken"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bold mode offers a balanced challenge with a good mix of small and large blocks"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El modo Audaz ofrece un desafío equilibrado con una buena mezcla de bloques pequeños y grandes"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "大胆は小さなブロックと大きなブロックがほどよく混ざった、バランスの取れた難易度です"
          }
        }
      }
