    "inspiration_quote" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entstanden aus der Liebe zu Block-Puzzles, dem Ärger über Werbung und der Inspiration durch die zeitlose Dichtung Walt Whitmans."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Born from a love of block puzzles, frustration with ads, and inspiration from Walt Whitman's timeless poetry."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nacido del amor por los rompecabezas de bloques, la frustración con los anuncios y la inspiración de la poesía atemporal de Walt Whitman."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Né d'un amour des jeux de blocs, d'une lassitude devant la publicité et de l'inspiration de la poésie intemporelle de Walt Whitman."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ブロックパズルへの愛情と、広告への苛立ち、そしてウォルト・ホイットマンの時を超えた詩から生まれました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "블록 퍼즐을 향한 애정과 광고에 대한 아쉬움, 그리고 월트 휘트먼의 시대를 넘어선 시에서 태어났어요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ontstaan uit liefde voor blokpuzzels, ergernis over advertenties en inspiratie door de tijdloze poëzie van Walt Whitman."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nasceu do amor por quebra-cabeças de blocos, da irritação com anúncios e da inspiração na poesia atemporal de Walt Whitman."
          }
        }
      }
    },
