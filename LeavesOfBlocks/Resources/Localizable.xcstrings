    "inspiration_quote" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entstanden aus der Liebe zu Block-Puzzles, dem Ärger über Werbung und der Inspiration durch die zeitlose Dichtung Walt Whitmans."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Born from a love of block puzzles, frustration with ads, and inspiration from Walt Whitman's timeless poetry."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nacido del amor por los rompecabezas de bloques, la frustración con los anuncios y la inspiración de la poesía atemporal de Walt Whitman."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ブロックパズルへの愛情と、広告への苛立ち、そしてウォルト・ホイットマンの時を超えた詩から生まれました。"
          }
        }
