      "comment" : "A label displaying the author of a quote. The argument is the author's name.",
      "isCommentAutoGenerated" : true
    },
    "\"%@\"" : {
      "comment" : "A quotation mark is inserted around the title of a book.",
      "isCommentAutoGenerated" : true
    },
