          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kolom wissen is een krachtig blauw blok dat bij plaatsing meteen een hele verticale kolom wist. Perfect om ruimte te maken."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
